package ssr

templ passwordResetRequestPage(vm passwordResetRequestPageData) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHeadWithOptions(vm.Metadata, siteHeadOptions{Enhance: true})
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main id="main-content" tabindex="-1" class="flex min-h-[60vh] items-center justify-center px-5 py-16 sm:px-8">
				<div class="w-full max-w-sm border-2 border-ink bg-paper">
					@flagBand("h-1.5")
					<div class="p-8">
						<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Account</p>
						<h1 class="mt-2 font-display text-3xl font-bold tracking-tight text-flag-blue">Reset password</h1>
						<p class="mt-3 text-sm leading-6 text-muted">Enter your account email and we will send a reset link that expires in 30 minutes.</p>
						if vm.Sent {
							<p role="status" class="mt-5 alert-success">{ passwordResetSentCopy }</p>
						}
						if vm.ErrorMessage != "" {
							<p role="alert" class="mt-5 alert-error">{ vm.ErrorMessage }</p>
						}
						<form method="post" action="/account/password-reset" data-testid="password-reset-request-form" class="mt-6 grid gap-4">
							<input type="hidden" name="guest_csrf_token" value={ vm.GuestCSRFToken }/>
							<label class="grid gap-2 text-xs font-medium text-muted">
								Email
								<input
									type="email"
									name="email"
									value={ vm.Email }
									autocomplete="email"
									required
									if vm.EmailError != "" {
										aria-invalid="true"
										aria-describedby="reset-email-error"
										autofocus
									}
									class="field-input h-12 text-base"
								/>
								if vm.EmailError != "" {
									<p id="reset-email-error" role="alert" class="field-error">{ vm.EmailError }</p>
								}
							</label>
							<button type="submit" class="inline-flex h-12 items-center justify-center bg-flag-red px-6 text-sm font-bold text-white transition hover:bg-flag-red-deep">Send reset link</button>
						</form>
						<p class="mt-5 text-sm leading-6 text-muted">Remembered it? <a href="/account/sign-in" class="font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Sign in</a></p>
					</div>
				</div>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}

templ passwordResetConfirmPage(vm passwordResetConfirmPageData) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHeadWithOptions(vm.Metadata, siteHeadOptions{Enhance: true})
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main id="main-content" tabindex="-1" class="flex min-h-[60vh] items-center justify-center px-5 py-16 sm:px-8">
				<div class="w-full max-w-sm border-2 border-ink bg-paper">
					@flagBand("h-1.5")
					<div class="p-8">
						<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Account</p>
						<h1 class="mt-2 font-display text-3xl font-bold tracking-tight text-flag-blue">Choose a new password</h1>
						if vm.ErrorMessage != "" {
							<p role="alert" class="mt-5 alert-error">{ vm.ErrorMessage }</p>
							<p class="mt-5 text-sm leading-6 text-muted"><a href="/account/password-reset" class="font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Request a new link</a></p>
						} else {
							<p class="mt-3 text-sm leading-6 text-muted">Use 8 to 72 bytes. Non-ASCII characters may count as more than one byte. Resetting your password signs out every device.</p>
							<form method="post" action="/account/password-reset/confirm" data-testid="password-reset-confirm-form" class="mt-6 grid gap-4">
								<input type="hidden" name="guest_csrf_token" value={ vm.GuestCSRFToken }/>
								<input type="hidden" name="token" value={ vm.Token }/>
								<label class="grid gap-2 text-xs font-medium text-muted">
									New password (8 to 72 bytes)
									<input
										type="password"
										name="new_password"
										autocomplete="new-password"
										required
										data-password-min-bytes="8"
										maxlength="72"
										if vm.PasswordError != "" {
											aria-invalid="true"
											aria-describedby="reset-password-error"
											autofocus
										}
										class="field-input h-12 text-base"
									/>
									if vm.PasswordError != "" {
										<p id="reset-password-error" role="alert" class="field-error">{ vm.PasswordError }</p>
									}
								</label>
								<button type="submit" class="inline-flex h-12 items-center justify-center bg-flag-red px-6 text-sm font-bold text-white transition hover:bg-flag-red-deep">Reset password</button>
							</form>
						}
					</div>
				</div>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}

templ accountPage(vm accountPageData) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHeadWithOptions(vm.Metadata, siteHeadOptions{Enhance: true})
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main id="main-content" tabindex="-1">
				<section class="px-5 pt-10 pb-12 sm:px-8 lg:pt-14 lg:pb-16">
					<div class="mx-auto w-full max-w-7xl">
						@breadcrumbNav(vm.Breadcrumbs)
						<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Account</p>
						<h1 class="mt-3 font-display text-5xl font-bold leading-none tracking-tight text-flag-blue sm:text-6xl">Your account</h1>
						<p class="mt-5 max-w-3xl text-lg leading-8 text-muted">Signed in as <span class="font-bold text-flag-blue">{ vm.Email }</span>.</p>
					</div>
				</section>
				@flagBand("h-3")
				<section class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-8 lg:py-16">
					if vm.PasswordChanged {
						<p role="status" class="mb-8 alert-success">Password changed. Other devices have been signed out.</p>
					}
					<div class="grid gap-8 lg:grid-cols-[1fr_22rem] lg:items-start">
						<div class="grid gap-8">
							<section aria-label="Recent orders" class="border border-flag-blue/15 bg-paper p-5 sm:p-6">
								<div class="flex items-end justify-between gap-4 border-b border-flag-blue/10 pb-5">
									<h2 class="font-display text-2xl font-bold tracking-tight text-flag-blue">Recent orders</h2>
									<a href="/orders" class="text-sm font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">All orders</a>
								</div>
								if len(vm.RecentOrders) == 0 {
									<p class="mt-5 text-sm leading-6 text-muted">No orders yet. Your orders appear here after checkout.</p>
								} else {
									<div class="mt-5 grid gap-3">
										for _, order := range vm.RecentOrders {
											<a href={ "/orders/" + order.ID } class="grid gap-1 border border-flag-blue/10 bg-flag-white p-4 transition hover:border-flag-blue sm:grid-cols-[1fr_auto] sm:items-center">
												<span class="text-sm font-medium text-ink">Placed { order.PlacedAt } · <span class="font-bold text-flag-blue">{ order.StatusLabel }</span></span>
												<span class="text-sm font-bold tabular-nums text-flag-red">{ order.Total }</span>
											</a>
										}
									</div>
								}
							</section>
							<section aria-label="Default address" class="border border-flag-blue/15 bg-paper p-5 sm:p-6">
								<div class="flex items-end justify-between gap-4 border-b border-flag-blue/10 pb-5">
									<h2 class="font-display text-2xl font-bold tracking-tight text-flag-blue">Default address</h2>
									<a href="/account/addresses" class="text-sm font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Manage addresses</a>
								</div>
								if vm.DefaultAddress != nil {
									<div class="mt-5 text-sm leading-6 text-muted">
										<p class="font-bold text-ink">{ vm.DefaultAddress.FullName }</p>
										<p>{ vm.DefaultAddress.Line1 }</p>
										if vm.DefaultAddress.Line2 != "" {
											<p>{ vm.DefaultAddress.Line2 }</p>
										}
										<p>{ vm.DefaultAddress.City }, { vm.DefaultAddress.Region } { vm.DefaultAddress.PostalCode }</p>
									</div>
								} else {
									<p class="mt-5 text-sm leading-6 text-muted">No default address yet. Save one to speed up checkout.</p>
								}
								<p class="mt-4 text-sm leading-6 text-muted"><a href="/account/payment-methods" class="font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Saved cards</a> are stored securely by Stripe.</p>
							</section>
						</div>
						<aside class="border border-flag-blue bg-flag-blue text-white">
							@flagBand("h-1.5")
							<div class="p-6">
								<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-white">Security</p>
								<h2 class="mt-2 font-display text-2xl font-bold tracking-tight text-white">Change password</h2>
								if vm.PasswordError != "" {
									<p role="alert" class="mt-4 border-l-4 border-flag-red bg-flag-red/20 px-4 py-3 text-sm font-semibold text-white">{ vm.PasswordError }</p>
								}
								<form method="post" action="/account/password" class="mt-5 grid gap-4">
									<input type="hidden" name="csrf_token" value={ vm.CSRFToken }/>
									<label class="grid gap-2 text-xs font-medium text-white/70">
										Current password
										<input type="password" name="current_password" autocomplete="current-password" required maxlength="72" class="h-12 border border-white/30 bg-white/10 px-4 text-base font-medium text-white transition focus:border-white focus:bg-white/20"/>
									</label>
									<label class="grid gap-2 text-xs font-medium text-white/70">
										New password (8 to 72 bytes)
										<input type="password" name="new_password" autocomplete="new-password" required data-password-min-bytes="8" maxlength="72" class="h-12 border border-white/30 bg-white/10 px-4 text-base font-medium text-white transition focus:border-white focus:bg-white/20"/>
									</label>
									<button type="submit" class="inline-flex h-12 items-center justify-center bg-flag-red px-6 text-sm font-bold text-white transition hover:bg-flag-red-deep focus-visible:outline-white">Change password</button>
								</form>
								<p class="mt-4 text-sm leading-6 text-white/70">Changing your password signs out every other device.</p>
								<form method="post" action="/account/sign-out" class="mt-6 border-t border-white/15 pt-6">
									<input type="hidden" name="csrf_token" value={ vm.CSRFToken }/>
									<button type="submit" class="inline-flex h-12 w-full items-center justify-center border-2 border-white/60 px-6 text-sm font-bold text-white transition hover:bg-white hover:text-flag-blue focus-visible:outline-white">Sign out</button>
								</form>
							</div>
						</aside>
					</div>
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}
