package ssr

templ accountPage(vm accountPageData) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead(vm.Metadata)
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main>
				<section class="px-5 pt-10 pb-12 sm:px-8 lg:pt-14 lg:pb-16">
					<div class="mx-auto w-full max-w-7xl">
						@breadcrumbNav(vm.Breadcrumbs)
						<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Account</p>
						<h1 class="mt-3 font-display text-5xl font-bold leading-none tracking-tight text-flag-blue sm:text-6xl">Your account</h1>
						<p class="mt-5 max-w-3xl text-lg leading-8 text-muted">Signed in as <span class="font-bold text-flag-blue">{ vm.Email }</span>.</p>
					</div>
				</section>
				@flagBand("h-3")
				<section class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-8 lg:py-16">
					if vm.PasswordChanged {
						<p role="status" class="mb-8 border-l-4 border-flag-blue bg-flag-blue/10 px-4 py-3 text-sm font-semibold text-flag-blue">Password changed. Other devices have been signed out.</p>
					}
					<div class="grid gap-8 lg:grid-cols-[1fr_22rem] lg:items-start">
						<div class="grid gap-8">
							<section aria-label="Recent orders" class="border border-flag-blue/15 bg-paper p-5 sm:p-6">
								<div class="flex items-end justify-between gap-4 border-b border-flag-blue/10 pb-5">
									<h2 class="font-display text-2xl font-bold tracking-tight text-flag-blue">Recent orders</h2>
									<a href="/orders" class="text-sm font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">All orders</a>
								</div>
								if len(vm.RecentOrders) == 0 {
									<p class="mt-5 text-sm leading-6 text-muted">No orders yet. Your orders appear here after checkout.</p>
								} else {
									<div class="mt-5 grid gap-3">
										for _, order := range vm.RecentOrders {
											<a href={ "/orders/" + order.ID } class="grid gap-1 border border-flag-blue/10 bg-flag-white p-4 transition hover:border-flag-blue sm:grid-cols-[1fr_auto] sm:items-center">
												<span class="text-sm font-medium text-ink">Placed { order.PlacedAt } · <span class="font-bold text-flag-blue">{ order.StatusLabel }</span></span>
												<span class="text-sm font-bold tabular-nums text-flag-red">{ order.Total }</span>
											</a>
										}
									</div>
								}
							</section>
							<section aria-label="Default address" class="border border-flag-blue/15 bg-paper p-5 sm:p-6">
								<div class="flex items-end justify-between gap-4 border-b border-flag-blue/10 pb-5">
									<h2 class="font-display text-2xl font-bold tracking-tight text-flag-blue">Default address</h2>
									<a href="/account/addresses" class="text-sm font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Manage addresses</a>
								</div>
								if vm.DefaultAddress != nil {
									<div class="mt-5 text-sm leading-6 text-muted">
										<p class="font-bold text-ink">{ vm.DefaultAddress.FullName }</p>
										<p>{ vm.DefaultAddress.Line1 }</p>
										if vm.DefaultAddress.Line2 != "" {
											<p>{ vm.DefaultAddress.Line2 }</p>
										}
										<p>{ vm.DefaultAddress.City }, { vm.DefaultAddress.Region } { vm.DefaultAddress.PostalCode }</p>
									</div>
								} else {
									<p class="mt-5 text-sm leading-6 text-muted">No default address yet. Save one to speed up checkout.</p>
								}
								<p class="mt-4 text-sm leading-6 text-muted"><a href="/account/payment-methods" class="font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Saved cards</a> are stored securely by Stripe.</p>
							</section>
						</div>
						<aside class="border border-flag-blue bg-flag-blue text-white">
							@flagBand("h-1.5")
							<div class="p-6">
								<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-white">Security</p>
								<h2 class="mt-2 font-display text-2xl font-bold tracking-tight text-white">Change password</h2>
								if vm.PasswordError != "" {
									<p role="alert" class="mt-4 border-l-4 border-flag-red bg-flag-red/20 px-4 py-3 text-sm font-semibold text-white">{ vm.PasswordError }</p>
								}
								<form method="post" action="/account/password" class="mt-5 grid gap-4">
									<input type="hidden" name="csrf_token" value={ vm.CSRFToken }/>
									<label class="grid gap-2 text-xs font-medium text-white/70">
										Current password
										<input type="password" name="current_password" autocomplete="current-password" required class="h-12 border border-white/30 bg-white/10 px-4 text-base font-medium text-white transition focus:border-white focus:bg-white/20"/>
									</label>
									<label class="grid gap-2 text-xs font-medium text-white/70">
										New password (8 to 72 characters)
										<input type="password" name="new_password" autocomplete="new-password" required minlength="8" class="h-12 border border-white/30 bg-white/10 px-4 text-base font-medium text-white transition focus:border-white focus:bg-white/20"/>
									</label>
									<button type="submit" class="inline-flex h-12 items-center justify-center bg-flag-red px-6 text-sm font-bold text-white transition hover:bg-flag-red-deep focus-visible:outline-white">Change password</button>
								</form>
								<p class="mt-4 text-sm leading-6 text-white/70">Changing your password signs out every other device.</p>
								<form method="post" action="/account/sign-out" class="mt-6 border-t border-white/15 pt-6">
									<input type="hidden" name="csrf_token" value={ vm.CSRFToken }/>
									<button type="submit" class="inline-flex h-12 w-full items-center justify-center border-2 border-white/60 px-6 text-sm font-bold text-white transition hover:bg-white hover:text-flag-blue focus-visible:outline-white">Sign out</button>
								</form>
							</div>
						</aside>
					</div>
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}
