package ssr

import "strconv"

templ addressEditPage(vm addressEditPageData) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead(vm.Metadata)
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main id="main-content" tabindex="-1" class="flex justify-center px-5 py-16 sm:px-8">
				<div class="w-full max-w-xl border-2 border-ink bg-paper">
					@flagBand("h-1.5")
					<div class="p-8">
						<a href="/account/addresses" class="text-sm font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Back to addresses</a>
						<h1 class="mt-4 font-display text-3xl font-bold tracking-tight text-flag-blue">Edit address</h1>
						if vm.Form.ErrorMessage != "" {
							<p role="alert" class="mt-5 alert-error">{ vm.Form.ErrorMessage }</p>
						}
						<form method="post" action={ "/account/addresses/" + vm.AddressID + "/update" } data-testid="address-form" class="mt-6 grid gap-4">
							<input type="hidden" name="csrf_token" value={ vm.CSRFToken }/>
							<input type="hidden" name="version" value={ strconv.Itoa(vm.Version) }/>
							@addressFormFields(vm.Form)
							<button type="submit" class="inline-flex h-12 items-center justify-center bg-flag-red px-6 text-sm font-bold text-white transition hover:bg-flag-red-deep">Save changes</button>
						</form>
					</div>
				</div>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}
