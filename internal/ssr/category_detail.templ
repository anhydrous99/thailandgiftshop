package ssr

templ categoryDetailPage(vm categoryDetailPageViewModel) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead(vm.Metadata)
		<body class="min-h-screen bg-[#F8F4EE] text-[#17172A] antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main>
				<section class="border-b border-[#2D2A4A]/10 bg-white px-5 py-14 sm:px-8 lg:py-18">
					<div class="mx-auto w-full max-w-7xl">
						@breadcrumbNav(vm.Breadcrumbs)
						<a href="/categories" class="text-sm font-black text-[#A51931] transition hover:text-[#831426]">Back to categories</a>
						<h1 class="mt-5 text-5xl font-black leading-none text-[#2D2A4A] sm:text-6xl">{ vm.Category.Name }</h1>
						<p class="mt-5 max-w-3xl text-lg leading-8 text-[#4C4A62]">{ vm.Category.Description }</p>
					</div>
				</section>
				<section class="mx-auto w-full max-w-7xl px-5 py-14 sm:px-8 lg:py-20">
					if len(vm.Products) == 0 {
						<section class="rounded-lg border border-dashed border-[#2D2A4A]/25 bg-white p-8 text-center shadow-sm">
							<h2 class="text-xl font-bold text-[#2D2A4A]">No products are available in this category yet.</h2>
							<p class="mt-2 text-sm leading-6 text-[#4C4A62]">Check back soon for more Thai gift-shop finds in this aisle.</p>
						</section>
					} else {
						<section aria-label="Category products" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
							for _, product := range vm.Products {
								@productCard(product, vm.ProductImagePlaceholderURL)
							}
						</section>
					}
					if len(vm.RelatedCategories) > 0 {
						<section aria-label="More categories" class="mt-10 rounded-lg border border-[#2D2A4A]/15 bg-white p-5 shadow-sm sm:p-6">
							<p class="text-sm font-black uppercase tracking-wide text-[#A51931]">More aisles</p>
							<h2 class="mt-2 text-3xl font-black text-[#2D2A4A] sm:text-4xl">Browse more Thai gift-shop categories</h2>
							<div class="mt-5 flex flex-wrap gap-2">
								for _, category := range vm.RelatedCategories {
									<a href={ "/categories/" + category.Slug } class="inline-flex rounded-full border border-[#2D2A4A]/15 bg-[#F8F4EE] px-3 py-1 text-xs font-black text-[#2D2A4A] shadow-sm transition hover:border-[#A51931]/30 hover:text-[#A51931]">{ category.Name }</a>
								}
							</div>
						</section>
					}
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}
