package ssr

templ categoryDetailPage(vm categoryDetailPageViewModel) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead(vm.Metadata)
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main id="main-content" tabindex="-1">
				<section class="px-5 pt-10 pb-12 sm:px-8 lg:pt-14 lg:pb-16">
					<div class="mx-auto w-full max-w-7xl">
						@breadcrumbNav(vm.Breadcrumbs)
						<a href="/categories" class="text-sm font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Back to categories</a>
						<h1 class="mt-5 font-display text-5xl font-bold leading-none tracking-tight text-flag-blue sm:text-6xl">{ vm.Category.Name }</h1>
						<p class="mt-5 max-w-3xl text-lg leading-8 text-muted">{ vm.Category.Description }</p>
					</div>
				</section>
				@flagBand("h-3")
				<section class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-8 lg:py-16">
					if len(vm.Products) == 0 {
						<section class="border-2 border-dashed border-flag-blue/25 bg-paper p-10 text-center">
							<div class="mx-auto w-16">
								@flagBand("h-1.5")
							</div>
							<h2 class="mt-5 font-display text-xl font-bold text-flag-blue">No products are available in this category yet.</h2>
							<p class="mt-2 text-sm leading-6 text-muted">Check back soon for more Thai gift-shop finds in this aisle.</p>
						</section>
					} else {
						<section aria-label="Category products" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
							for index, product := range vm.Products {
								@productCard(product, vm.ProductImagePlaceholderURL, index < 4)
							}
						</section>
					}
					if len(vm.RelatedCategories) > 0 {
						<section aria-label="More categories" class="mt-12 bg-flag-white p-6 sm:p-8">
							<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">More aisles</p>
							<h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-flag-blue sm:text-4xl">Browse more Thai gift-shop categories</h2>
							<div class="mt-5 flex flex-wrap gap-2">
								for _, category := range vm.RelatedCategories {
									<a href={ "/categories/" + category.Slug } class="inline-flex border border-flag-blue/20 bg-paper px-3 py-1.5 text-xs font-semibold text-flag-blue transition hover:border-flag-red hover:text-flag-red">{ category.Name }</a>
								}
							</div>
						</section>
					}
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}
