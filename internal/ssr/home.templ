package ssr

import "github.com/anhydrous99/thailandgiftshop/internal/catalog"

templ home(products []catalog.Product, productImagePlaceholderURL string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Thailand Gift Shop</title>
			<link rel="icon" href="/static/favicon.ico" sizes="any"/>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			<link rel="apple-touch-icon" href="/static/apple-touch-icon.png" sizes="180x180"/>
			<link rel="manifest" href="/static/site.webmanifest"/>
			<link rel="stylesheet" href="/static/assets/app.css"/>
			<script src="/static/vendor/htmx.min.js" defer></script>
		</head>
		<body class="min-h-screen bg-stone-50 text-stone-950">
			<main class="mx-auto min-h-screen w-full max-w-6xl px-5 py-10 sm:px-8">
				<section class="mb-8 border-b border-stone-200 pb-6">
					<p class="mb-2 text-sm font-semibold uppercase tracking-widest text-emerald-700">Thailand Gift Shop</p>
					<h1 class="max-w-3xl text-4xl font-bold tracking-tight text-stone-950">Thai gifts, pantry favorites, and small-batch keepsakes.</h1>
					<p class="mt-4 max-w-2xl text-base leading-7 text-stone-700">Browse the current catalog served from DynamoDB, with product images delivered through CloudFront.</p>
				</section>
				if len(products) == 0 {
					<section class="rounded-lg border border-dashed border-stone-300 bg-white p-8 text-center">
						<h2 class="text-xl font-semibold text-stone-950">No products are available yet.</h2>
						<p class="mt-2 text-sm text-stone-600">Seed or publish catalog products to show them here.</p>
					</section>
				} else {
					<section aria-label="Products" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
						for _, product := range products {
							<article data-testid="product-card" class="overflow-hidden rounded-lg border border-stone-200 bg-white shadow-sm">
								<img class="aspect-[4/3] w-full bg-stone-100 object-cover" src={ product.DisplayImageURL(productImagePlaceholderURL) } alt={ product.Name } loading="lazy"/>
								<div class="p-5">
									<div class="flex items-start justify-between gap-4">
										<h2 class="text-lg font-semibold leading-6 text-stone-950">{ product.Name }</h2>
										<p class="shrink-0 text-sm font-bold text-emerald-700">{ formatPrice(product.PriceCents) }</p>
									</div>
									<p class="mt-3 line-clamp-3 text-sm leading-6 text-stone-600">{ product.Description }</p>
									if product.OutOfStock() {
										<p class="mt-4 inline-flex rounded-full bg-rose-100 px-3 py-1 text-xs font-bold uppercase tracking-widest text-rose-700">Out of stock</p>
									}
								</div>
							</article>
						}
					</section>
				}
			</main>
		</body>
	</html>
}
