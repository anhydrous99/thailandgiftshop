package ssr

import "github.com/anhydrous99/thailandgiftshop/internal/catalog"

templ home(vm homePageViewModel) {
		<!DOCTYPE html>
		<html lang="en" class="scroll-smooth">
			@siteHead("Thailand Gift Shop")
			<body class="min-h-screen bg-[#F8F4EE] text-[#17172A] antialiased">
			@siteHeader("home", vm.HeaderCartLabel)
			<main>
				<section class="relative isolate overflow-hidden bg-[#2D2A4A] text-white">
					<img class="absolute inset-0 -z-30 h-full w-full object-cover object-center opacity-85" src="/static/home-hero.png" alt="" aria-hidden="true"/>
					<div class="absolute inset-0 -z-20 bg-[linear-gradient(90deg,rgba(45,42,74,0.98)_0%,rgba(45,42,74,0.88)_36%,rgba(45,42,74,0.46)_64%,rgba(45,42,74,0.18)_100%)]"></div>
					<div class="absolute inset-x-0 bottom-0 -z-10 h-28 bg-gradient-to-t from-[#2D2A4A] to-transparent"></div>
					<div aria-hidden="true" class="absolute left-0 top-0 h-full w-1.5 bg-[#A51931]"></div>
					<div class="mx-auto grid min-h-[510px] w-full max-w-7xl content-end px-5 py-12 sm:min-h-[560px] sm:px-8 lg:py-16">
						<div class="max-w-3xl">
							<p class="mb-4 inline-flex rounded-full border border-white/25 bg-white/10 px-4 py-2 text-sm font-black text-white shadow-sm backdrop-blur">Bangkok gift shop online</p>
							<h1 class="text-5xl font-black leading-none text-white sm:text-6xl lg:text-7xl">Thailand Gift Shop</h1>
							<p class="mt-6 max-w-2xl text-lg leading-8 text-white/90">Thai snacks, souvenirs, textiles, home accents, and small keepsakes inspired by the gift shops travelers browse around Bangkok.</p>
							<div class="mt-8 flex flex-wrap gap-3">
								<a href="#latest" class="inline-flex h-12 items-center justify-center rounded-full bg-[#A51931] px-6 text-sm font-black text-white shadow-sm transition hover:bg-[#831426] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Shop latest finds</a>
								<a href="#shop-aisles" class="inline-flex h-12 items-center justify-center rounded-full border border-white/45 bg-white/10 px-6 text-sm font-black text-white backdrop-blur transition hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Browse aisles</a>
							</div>
							<ul class="mt-10 grid max-w-3xl gap-4 text-sm font-bold text-white/90 sm:grid-cols-3">
								<li class="border-l-4 border-[#A51931] pl-4">Thai snack favorites</li>
								<li class="border-l-4 border-[#F4F5F8] pl-4">Souvenirs and keepsakes</li>
								<li class="border-l-4 border-[#D8AE5E] pl-4">Textiles and home accents</li>
							</ul>
						</div>
					</div>
				</section>
				<section id="latest" class="mx-auto w-full max-w-7xl px-5 py-14 sm:px-8 lg:py-20">
					<div class="mb-8 flex flex-col gap-4 border-b border-[#2D2A4A]/10 pb-6 md:flex-row md:items-end md:justify-between">
						<div>
							<p class="text-sm font-black uppercase tracking-wide text-[#A51931]">Just added</p>
							<h2 class="mt-2 text-3xl font-black text-[#2D2A4A] sm:text-4xl">Latest products</h2>
						</div>
						<p class="max-w-2xl text-base leading-7 text-[#4C4A62]">New arrivals appear here first, with compact details that make browsing fast and confident.</p>
					</div>
					if len(vm.Products) == 0 {
						<section class="rounded-lg border border-dashed border-[#2D2A4A]/25 bg-white p-8 text-center shadow-sm">
							<h2 class="text-xl font-bold text-[#2D2A4A]">No products are available yet.</h2>
							<p class="mt-2 text-sm leading-6 text-[#4C4A62]">Check back soon for Thai gift-shop finds.</p>
						</section>
					} else {
						<section aria-label="Latest added products" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
							for _, product := range vm.Products {
								@productCard(product, vm.ProductImagePlaceholderURL)
							}
						</section>
					}
				</section>
				<section id="shop-aisles" class="bg-white py-14 lg:py-20">
					<div class="mx-auto w-full max-w-7xl px-5 sm:px-8">
						<div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
							<div>
								<p class="text-sm font-black uppercase tracking-wide text-[#A51931]">Shop aisles</p>
								<h2 class="mt-2 text-3xl font-black text-[#2D2A4A] sm:text-4xl">Browse like you are at a Bangkok gift shop.</h2>
								<p class="mt-4 text-base leading-7 text-[#4C4A62]">Move through familiar shelves of snacks, souvenirs, textiles, decor, and wellness finds.</p>
							</div>
							<div class="grid gap-4 sm:grid-cols-3">
								if len(vm.FeaturedCategories) == 0 {
									<section class="rounded-lg border border-dashed border-[#2D2A4A]/25 bg-[#F8F4EE] p-5 text-[#17172A] shadow-sm sm:col-span-3">
										<h3 class="text-lg font-black text-[#2D2A4A]">Aisles are being prepared.</h3>
										<p class="mt-3 text-sm leading-6 text-[#4C4A62]">Check back soon for active Thai gift-shop categories.</p>
									</section>
								} else {
									for _, category := range vm.FeaturedCategories {
										@homeAisleCard(category)
									}
								}
							</div>
						</div>
					</div>
				</section>
				<section id="categories" class="mx-auto w-full max-w-7xl px-5 py-14 sm:px-8 lg:py-20">
					<div class="mb-8 max-w-3xl">
						<p class="text-sm font-black uppercase tracking-wide text-[#A51931]">Shop categories</p>
						<h2 class="mt-2 text-3xl font-black text-[#2D2A4A] sm:text-4xl">Clear categories for Thai gift-shop finds.</h2>
					</div>
					if len(vm.Categories) == 0 {
						<section class="rounded-lg border border-dashed border-[#2D2A4A]/25 bg-white p-8 text-center shadow-sm">
							<h2 class="text-xl font-bold text-[#2D2A4A]">No categories are available yet.</h2>
							<p class="mt-2 text-sm leading-6 text-[#4C4A62]">Check back soon for more Thai gift-shop aisles.</p>
						</section>
					} else {
						<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
							for _, category := range vm.Categories {
								@categoryCard(category)
							}
						</div>
					}
				</section>
				<section id="story" class="border-y border-[#2D2A4A]/10 bg-[#2D2A4A] py-14 text-white lg:py-20">
					<div class="mx-auto grid w-full max-w-7xl gap-8 px-5 sm:px-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
						<div>
							<p class="text-sm font-black uppercase tracking-wide text-[#F4F5F8]">Gift shop point of view</p>
							<h2 class="mt-2 text-3xl font-black sm:text-4xl">An online Thai gift shop shaped by Bangkok color, craft, flavor, and easy browsing.</h2>
						</div>
						<div class="border-l-4 border-[#A51931] pl-5">
							<p class="text-base leading-8 text-white/80">Every section is built to move shoppers quickly from aisle to product: clear categories, strong imagery, concise details, and a brand system grounded in the Thai flag.</p>
						</div>
					</div>
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}

templ homeAisleCard(category catalog.Category) {
	<a data-testid="home-aisle-card" href={ "/categories/" + category.Slug } class="group overflow-hidden rounded-lg border border-[#2D2A4A]/15 bg-[#F8F4EE] text-[#17172A] shadow-sm transition hover:-translate-y-1 hover:border-[#A51931]/30 hover:shadow-md">
		<span aria-hidden="true" class="block h-1.5 bg-[#A51931]"></span>
		<span class="block p-5">
			<span class="block text-lg font-black text-[#2D2A4A]">{ category.Name }</span>
			<span class="mt-3 block text-sm leading-6 text-[#4C4A62]">{ category.Description }</span>
		</span>
	</a>
}
