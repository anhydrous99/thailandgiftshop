package ssr

import "github.com/anhydrous99/thailandgiftshop/internal/catalog"

templ home(products []catalog.Product, productImagePlaceholderURL string) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Thailand Gift Shop</title>
			<link rel="icon" href="/static/favicon.ico" sizes="any"/>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			<link rel="apple-touch-icon" href="/static/apple-touch-icon.png" sizes="180x180"/>
			<link rel="manifest" href="/static/site.webmanifest"/>
			<link rel="stylesheet" href="/static/assets/app.css"/>
			<script src="/static/vendor/htmx.min.js" defer></script>
		</head>
		<body class="min-h-screen bg-[#F8F4EE] text-[#17172A] antialiased">
			<header class="sticky top-0 z-30 border-b border-[#2D2A4A]/10 bg-white/95 shadow-sm backdrop-blur">
				<div aria-hidden="true" class="grid h-1 grid-cols-[1fr_1fr_2fr_1fr_1fr]">
					<span class="bg-[#A51931]"></span>
					<span class="bg-[#F4F5F8]"></span>
					<span class="bg-[#2D2A4A]"></span>
					<span class="bg-[#F4F5F8]"></span>
					<span class="bg-[#A51931]"></span>
				</div>
				<nav aria-label="Main navigation" class="mx-auto flex min-h-16 w-full max-w-7xl items-center justify-between gap-3 px-5 sm:px-8">
					<a href="/" aria-label="Thailand Gift Shop home" class="flex min-w-0 items-center">
						<img class="h-10 w-auto max-w-[52vw] sm:h-12 sm:max-w-[240px]" src="/static/logo.svg" alt="Thailand Gift Shop"/>
					</a>
					<div class="hidden items-center gap-7 text-sm font-bold text-[#2D2A4A] md:flex">
						<a class="transition hover:text-[#A51931]" href="#latest">Latest</a>
						<a class="transition hover:text-[#A51931]" href="#gift-sets">Gift Sets</a>
						<a class="transition hover:text-[#A51931]" href="#categories">Categories</a>
						<a class="transition hover:text-[#A51931]" href="#story">Story</a>
					</div>
					<a href="#latest" class="inline-flex h-10 shrink-0 items-center justify-center rounded-full bg-[#A51931] px-4 text-sm font-black text-white shadow-sm transition hover:bg-[#831426] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2D2A4A]">Shop gifts</a>
				</nav>
			</header>
			<main>
				<section class="relative isolate overflow-hidden bg-[#2D2A4A] text-white">
					<img class="absolute inset-0 -z-30 h-full w-full object-cover object-center opacity-85" src="/static/home-hero.png" alt="" aria-hidden="true"/>
					<div class="absolute inset-0 -z-20 bg-[linear-gradient(90deg,rgba(45,42,74,0.98)_0%,rgba(45,42,74,0.88)_36%,rgba(45,42,74,0.46)_64%,rgba(45,42,74,0.18)_100%)]"></div>
					<div class="absolute inset-x-0 bottom-0 -z-10 h-28 bg-gradient-to-t from-[#2D2A4A] to-transparent"></div>
					<div aria-hidden="true" class="absolute left-0 top-0 h-full w-1.5 bg-[#A51931]"></div>
					<div class="mx-auto grid min-h-[510px] w-full max-w-7xl content-end px-5 py-12 sm:min-h-[560px] sm:px-8 lg:py-16">
						<div class="max-w-3xl">
							<p class="mb-4 inline-flex rounded-full border border-white/25 bg-white/10 px-4 py-2 text-sm font-black text-white shadow-sm backdrop-blur">Premium Thai gifting</p>
							<h1 class="text-5xl font-black leading-none text-white sm:text-6xl lg:text-7xl">Thailand Gift Shop</h1>
							<p class="mt-6 max-w-2xl text-lg leading-8 text-white/90">Curated Thai gifts for pantry nights, calm rituals, thoughtful keepsakes, and ready-to-wrap moments.</p>
							<div class="mt-8 flex flex-wrap gap-3">
								<a href="#latest" class="inline-flex h-12 items-center justify-center rounded-full bg-[#A51931] px-6 text-sm font-black text-white shadow-sm transition hover:bg-[#831426] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Shop latest products</a>
								<a href="#categories" class="inline-flex h-12 items-center justify-center rounded-full border border-white/45 bg-white/10 px-6 text-sm font-black text-white backdrop-blur transition hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Browse categories</a>
							</div>
							<ul class="mt-10 grid max-w-3xl gap-4 text-sm font-bold text-white/90 sm:grid-cols-3">
								<li class="border-l-4 border-[#A51931] pl-4">Gift-ready pantry picks</li>
								<li class="border-l-4 border-[#F4F5F8] pl-4">Textiles and keepsakes</li>
								<li class="border-l-4 border-[#D8AE5E] pl-4">Small-batch home accents</li>
							</ul>
						</div>
					</div>
				</section>
				<section id="latest" class="mx-auto w-full max-w-7xl px-5 py-14 sm:px-8 lg:py-20">
					<div class="mb-8 flex flex-col gap-4 border-b border-[#2D2A4A]/10 pb-6 md:flex-row md:items-end md:justify-between">
						<div>
							<p class="text-sm font-black uppercase tracking-wide text-[#A51931]">Just added</p>
							<h2 class="mt-2 text-3xl font-black text-[#2D2A4A] sm:text-4xl">Latest products</h2>
						</div>
						<p class="max-w-2xl text-base leading-7 text-[#4C4A62]">Newly published gifts appear here first, with compact details that make browsing fast and confident.</p>
					</div>
					if len(products) == 0 {
						<section class="rounded-lg border border-dashed border-[#2D2A4A]/25 bg-white p-8 text-center shadow-sm">
							<h2 class="text-xl font-bold text-[#2D2A4A]">No products are available yet.</h2>
							<p class="mt-2 text-sm leading-6 text-[#4C4A62]">Seed or publish catalog products to show them here.</p>
						</section>
					} else {
						<section aria-label="Latest added products" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
							for _, product := range products {
								<article data-testid="product-card" class="group overflow-hidden rounded-lg border border-[#2D2A4A]/15 bg-white shadow-sm transition hover:-translate-y-1 hover:border-[#A51931]/30 hover:shadow-lg">
									<img class="aspect-[4/3] w-full bg-[#F4F5F8] object-cover transition duration-300 group-hover:scale-105" src={ product.DisplayImageURL(productImagePlaceholderURL) } alt={ product.Name } loading="lazy"/>
									<div class="p-5">
										<div class="flex items-start justify-between gap-4">
											<h3 class="text-lg font-black leading-6 text-[#2D2A4A]">{ product.Name }</h3>
											<p class="shrink-0 rounded-full bg-[#F4F5F8] px-3 py-1 text-sm font-black text-[#A51931]">{ formatPrice(product.PriceCents) }</p>
										</div>
										<p class="mt-3 line-clamp-3 text-sm leading-6 text-[#4C4A62]">{ product.Description }</p>
										if product.OutOfStock() {
											<p class="mt-4 inline-flex rounded-full bg-[#A51931]/10 px-3 py-1 text-xs font-black text-[#A51931]">Out of stock</p>
										} else {
											<p class="mt-4 inline-flex rounded-full bg-[#2D2A4A]/10 px-3 py-1 text-xs font-black text-[#2D2A4A]">Ready to gift</p>
										}
									</div>
								</article>
							}
						</section>
					}
				</section>
				<section id="gift-sets" class="bg-white py-14 lg:py-20">
					<div class="mx-auto w-full max-w-7xl px-5 sm:px-8">
						<div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
							<div>
								<p class="text-sm font-black uppercase tracking-wide text-[#A51931]">Gift paths</p>
								<h2 class="mt-2 text-3xl font-black text-[#2D2A4A] sm:text-4xl">Choose by occasion, then make it unmistakably Thai.</h2>
								<p class="mt-4 text-base leading-7 text-[#4C4A62]">Shop paths group pantry favorites, calming rituals, and home accents into giftable starting points.</p>
							</div>
							<div class="grid gap-4 sm:grid-cols-3">
								<a href="#latest" class="group overflow-hidden rounded-lg border border-[#2D2A4A]/15 bg-[#F8F4EE] text-[#17172A] shadow-sm transition hover:-translate-y-1 hover:border-[#A51931]/30 hover:shadow-md">
									<span aria-hidden="true" class="block h-1.5 bg-[#A51931]"></span>
									<span class="block p-5">
										<span class="block text-lg font-black text-[#2D2A4A]">Pantry Night</span>
										<span class="mt-3 block text-sm leading-6 text-[#4C4A62]">Curry kits, Thai tea, sauces, rice sweets, and snackable tasting boxes.</span>
									</span>
								</a>
								<a href="#latest" class="group overflow-hidden rounded-lg border border-[#2D2A4A]/15 bg-[#F8F4EE] text-[#17172A] shadow-sm transition hover:-translate-y-1 hover:border-[#2D2A4A]/30 hover:shadow-md">
									<span aria-hidden="true" class="block h-1.5 bg-[#2D2A4A]"></span>
									<span class="block p-5">
										<span class="block text-lg font-black text-[#2D2A4A]">Home Accent</span>
										<span class="mt-3 block text-sm leading-6 text-[#4C4A62]">Candles, cups, brass pieces, magnets, and shelf-size keepsakes.</span>
									</span>
								</a>
								<a href="#latest" class="group overflow-hidden rounded-lg border border-[#2D2A4A]/15 bg-[#F8F4EE] text-[#17172A] shadow-sm transition hover:-translate-y-1 hover:border-[#D8AE5E]/50 hover:shadow-md">
									<span aria-hidden="true" class="block h-1.5 bg-[#D8AE5E]"></span>
									<span class="block p-5">
										<span class="block text-lg font-black text-[#2D2A4A]">Spa Reset</span>
										<span class="mt-3 block text-sm leading-6 text-[#4C4A62]">Lemongrass, jasmine, textiles, pouches, and unwind-ready bundles.</span>
									</span>
								</a>
							</div>
						</div>
					</div>
				</section>
				<section id="categories" class="mx-auto w-full max-w-7xl px-5 py-14 sm:px-8 lg:py-20">
					<div class="mb-8 max-w-3xl">
						<p class="text-sm font-black uppercase tracking-wide text-[#A51931]">Shop structure</p>
						<h2 class="mt-2 text-3xl font-black text-[#2D2A4A] sm:text-4xl">Clear categories for every gifting style.</h2>
					</div>
					<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
						<a href="#latest" class="rounded-lg border border-[#2D2A4A]/15 bg-white p-5 shadow-sm transition hover:border-[#A51931]/30 hover:shadow-md">
							<p class="text-base font-black text-[#2D2A4A]">Gift Sets</p>
							<p class="mt-2 text-sm leading-6 text-[#4C4A62]">Ready-to-wrap combinations.</p>
						</a>
						<a href="#latest" class="rounded-lg border border-[#2D2A4A]/15 bg-white p-5 shadow-sm transition hover:border-[#A51931]/30 hover:shadow-md">
							<p class="text-base font-black text-[#2D2A4A]">Thai Pantry</p>
							<p class="mt-2 text-sm leading-6 text-[#4C4A62]">Cooking staples and sweets.</p>
						</a>
						<a href="#latest" class="rounded-lg border border-[#2D2A4A]/15 bg-white p-5 shadow-sm transition hover:border-[#A51931]/30 hover:shadow-md">
							<p class="text-base font-black text-[#2D2A4A]">Textiles</p>
							<p class="mt-2 text-sm leading-6 text-[#4C4A62]">Scarves, pouches, and woven goods.</p>
						</a>
						<a href="#latest" class="rounded-lg border border-[#2D2A4A]/15 bg-white p-5 shadow-sm transition hover:border-[#A51931]/30 hover:shadow-md">
							<p class="text-base font-black text-[#2D2A4A]">Home Decor</p>
							<p class="mt-2 text-sm leading-6 text-[#4C4A62]">Compact accents and keepsakes.</p>
						</a>
					</div>
				</section>
				<section id="story" class="border-y border-[#2D2A4A]/10 bg-[#2D2A4A] py-14 text-white lg:py-20">
					<div class="mx-auto grid w-full max-w-7xl gap-8 px-5 sm:px-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
						<div>
							<p class="text-sm font-black uppercase tracking-wide text-[#F4F5F8]">Curation point of view</p>
							<h2 class="mt-2 text-3xl font-black sm:text-4xl">A gift shop shaped by Thai color, craft, flavor, and ease.</h2>
						</div>
						<div class="border-l-4 border-[#A51931] pl-5">
							<p class="text-base leading-8 text-white/80">Every section is built to move shoppers quickly from occasion to product: clear paths, strong imagery, concise details, and a brand system grounded in the Thai flag.</p>
						</div>
					</div>
				</section>
			</main>
			<footer class="bg-[#17172A] px-5 py-10 text-white sm:px-8">
				<div class="mx-auto flex w-full max-w-7xl flex-col gap-5 text-sm text-white/72 sm:flex-row sm:items-center sm:justify-between">
					<a href="/" aria-label="Thailand Gift Shop home" class="inline-flex w-fit rounded-md bg-white px-2 py-1">
						<img class="h-9 w-auto" src="/static/logo.svg" alt="Thailand Gift Shop"/>
					</a>
					<p>Thai gifts, pantry favorites, and small-batch keepsakes.</p>
				</div>
			</footer>
		</body>
	</html>
}
