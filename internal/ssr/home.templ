package ssr

import "github.com/anhydrous99/thailandgiftshop/internal/catalog"

templ home(vm homePageViewModel) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead(vm.Metadata)
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("home", vm.HeaderCartLabel)
			<main id="main-content" tabindex="-1">
				<section data-testid="home-building-banner" aria-label="Home page status" class="border-b-2 border-ink bg-flag-white">
					@flagBand("h-3")
					<div class="mx-auto w-full max-w-7xl px-5 py-5 sm:px-8">
						<div class="grid gap-4 border-2 border-ink bg-paper p-5 shadow-lift sm:grid-cols-[auto_1fr] sm:items-center sm:p-6">
							<span aria-hidden="true" class="flex h-14 w-14 items-center justify-center bg-flag-blue font-display text-3xl font-bold text-white">!</span>
							<div>
								<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Shop status</p>
								<p class="mt-2 font-display text-3xl font-bold leading-tight text-flag-blue sm:text-4xl">This page is being built.</p>
								<p class="mt-2 text-base font-medium leading-7 text-muted">We are still preparing the shop experience.</p>
							</div>
						</div>
					</div>
				</section>
				<section class="bg-flag-blue text-white">
					<div class="mx-auto grid w-full max-w-7xl lg:grid-cols-[1.05fr_0.95fr]">
						<div class="px-5 py-14 sm:px-8 lg:py-24">
							<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-white">Bangkok gift shop online</p>
							<h1 class="mt-4 font-display text-6xl font-bold leading-[0.92] tracking-tight text-white sm:text-7xl lg:text-8xl">Thailand Gift Shop</h1>
							<p class="mt-6 max-w-2xl text-lg leading-8 text-white/85">Thai snacks, souvenirs, textiles, home accents, and small keepsakes inspired by the gift shops travelers browse around Bangkok.</p>
							<div class="mt-8 flex flex-wrap gap-3">
								<a href="#latest" class="inline-flex h-12 items-center justify-center bg-flag-red px-6 text-sm font-bold text-white transition hover:bg-flag-red-deep focus-visible:outline-white">Shop latest finds</a>
								<a href="#shop-aisles" class="inline-flex h-12 items-center justify-center border-2 border-white/60 px-6 text-sm font-bold text-white transition hover:bg-white hover:text-flag-blue focus-visible:outline-white">Browse aisles</a>
							</div>
							<ul class="mt-10 grid max-w-2xl gap-4 text-sm font-medium text-white/90 sm:grid-cols-3">
								<li class="border-l-4 border-flag-red pl-4">Thai snack favorites</li>
								<li class="border-l-4 border-flag-white pl-4">Souvenirs and keepsakes</li>
								<li class="border-l-4 border-gold pl-4">Textiles and home accents</li>
							</ul>
						</div>
						<div class="relative hidden lg:block">
							<picture>
								<source srcset="/static/home-hero.webp" type="image/webp"/>
								<img class="absolute inset-0 h-full w-full object-cover" src="/static/home-hero.jpg" alt="" aria-hidden="true" width="1600" height="900" fetchpriority="high"/>
							</picture>
							<div class="absolute inset-y-0 left-0">
								@flagEdge("w-3")
							</div>
						</div>
					</div>
					@flagBand("h-6")
				</section>
				<section id="latest" class="mx-auto w-full max-w-7xl px-5 py-14 sm:px-8 lg:py-20">
					<div class="mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
						<div>
							<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Just added</p>
							<h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-flag-blue sm:text-4xl">Latest products</h2>
							<span aria-hidden="true" class="mt-4 block h-1 w-16 bg-flag-red"></span>
						</div>
						<p class="max-w-2xl text-base leading-7 text-muted">New arrivals appear here first, with compact details that make browsing fast and confident.</p>
					</div>
					if len(vm.Products) == 0 {
						<section class="border-2 border-dashed border-flag-blue/25 bg-paper p-10 text-center">
							<div class="mx-auto w-16">
								@flagBand("h-1.5")
							</div>
							<h2 class="mt-5 font-display text-xl font-bold text-flag-blue">No products are available yet.</h2>
							<p class="mt-2 text-sm leading-6 text-muted">Check back soon for Thai gift-shop finds.</p>
						</section>
					} else {
						<section aria-label="Latest added products" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
							for index, product := range vm.Products {
								@productCard(product, vm.ProductImagePlaceholderURL, index < 4)
							}
						</section>
					}
				</section>
				<section id="shop-aisles" class="bg-flag-white py-14 lg:py-20">
					<div class="mx-auto w-full max-w-7xl px-5 sm:px-8">
						<div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
							<div>
								<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Shop aisles</p>
								<h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-flag-blue sm:text-4xl">Browse like you are at a Bangkok gift shop.</h2>
								<span aria-hidden="true" class="mt-4 block h-1 w-16 bg-flag-red"></span>
								<p class="mt-4 text-base leading-7 text-muted">Move through familiar shelves of snacks, souvenirs, textiles, decor, and wellness finds.</p>
							</div>
							<div class="grid gap-4 sm:grid-cols-3">
								if len(vm.FeaturedCategories) == 0 {
									<section class="border-2 border-dashed border-flag-blue/25 bg-paper p-5 sm:col-span-3">
										<h3 class="font-display text-lg font-bold text-flag-blue">Aisles are being prepared.</h3>
										<p class="mt-3 text-sm leading-6 text-muted">Check back soon for active Thai gift-shop categories.</p>
									</section>
								} else {
									for _, category := range vm.FeaturedCategories {
										@homeAisleCard(category)
									}
								}
							</div>
						</div>
					</div>
				</section>
				<section id="categories" class="mx-auto w-full max-w-7xl px-5 py-14 sm:px-8 lg:py-20">
					<div class="mb-8 max-w-3xl">
						<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Shop categories</p>
						<h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-flag-blue sm:text-4xl">Clear categories for Thai gift-shop finds.</h2>
						<span aria-hidden="true" class="mt-4 block h-1 w-16 bg-flag-red"></span>
					</div>
					if len(vm.Categories) == 0 {
						<section class="border-2 border-dashed border-flag-blue/25 bg-paper p-10 text-center">
							<div class="mx-auto w-16">
								@flagBand("h-1.5")
							</div>
							<h2 class="mt-5 font-display text-xl font-bold text-flag-blue">No categories are available yet.</h2>
							<p class="mt-2 text-sm leading-6 text-muted">Check back soon for more Thai gift-shop aisles.</p>
						</section>
					} else {
						<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
							for _, category := range vm.Categories {
								@categoryCard(category)
							}
						</div>
					}
				</section>
				<section id="story" class="bg-flag-blue text-white">
					@flagBand("h-3")
					<div class="mx-auto grid w-full max-w-7xl gap-8 px-5 py-14 sm:px-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:py-20">
						<div>
							<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-white">Gift shop point of view</p>
							<h2 class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-4xl">An online Thai gift shop shaped by Bangkok color, craft, flavor, and easy browsing.</h2>
						</div>
						<div class="border-l-4 border-flag-red pl-5">
							<p class="text-base leading-8 text-white/80">Every section is built to move shoppers quickly from aisle to product: clear categories, strong imagery, concise details, and a brand system grounded in the Thai flag.</p>
						</div>
					</div>
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}

templ homeAisleCard(category catalog.Category) {
	<a data-testid="home-aisle-card" href={ "/categories/" + category.Slug } class="group block border border-flag-blue/15 bg-paper transition hover:border-flag-blue hover:shadow-lift">
		<span aria-hidden="true" class="block h-1.5 bg-flag-red"></span>
		<span class="block p-5">
			<span class="block font-display text-lg font-medium text-flag-blue">{ category.Name }</span>
			<span class="mt-3 block text-sm leading-6 text-muted">{ category.Description }</span>
		</span>
	</a>
}
