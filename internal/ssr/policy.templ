package ssr

templ policyPage(vm policyPageViewModel) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead(vm.Metadata)
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main id="main-content" tabindex="-1">
				<section class="px-5 pt-10 pb-12 sm:px-8 lg:pt-14 lg:pb-16">
					<div class="mx-auto w-full max-w-7xl">
						@breadcrumbNav(vm.Breadcrumbs)
						<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">{ vm.Eyebrow }</p>
						<h1 class="mt-3 font-display text-5xl font-bold leading-none tracking-tight text-flag-blue sm:text-6xl">{ vm.Title }</h1>
						if vm.Intro != "" {
							<p class="mt-5 max-w-3xl text-lg leading-8 text-muted">{ vm.Intro }</p>
						}
					</div>
				</section>
				@flagBand("h-3")
				<section class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-8 lg:py-16">
					<div class="max-w-3xl">
						if vm.Draft {
							<div data-testid="policy-draft-notice" role="note" class="mb-8 border-l-4 border-flag-red bg-flag-red/10 px-4 py-3 text-sm font-semibold leading-6 text-flag-red">This policy is a draft pending legal review and is not yet final.</div>
						}
						if vm.ContactEmail != "" {
							<p class="mb-8 text-lg leading-8 text-ink">Email us at <a class="font-bold text-flag-red underline underline-offset-4 transition hover:text-flag-red-deep focus-visible:outline-flag-red" href={ "mailto:" + vm.ContactEmail }>{ vm.ContactEmail }</a>.</p>
						}
						for _, section := range vm.Sections {
							<section class="mb-8">
								<h2 class="font-display text-2xl font-bold tracking-tight text-flag-blue">{ section.Heading }</h2>
								<span aria-hidden="true" class="mt-3 block h-1 w-12 bg-flag-red"></span>
								for _, paragraph := range section.Paragraphs {
									<p class="mt-4 text-lg leading-8 text-muted">{ paragraph }</p>
								}
							</section>
						}
						if vm.UpdatedNote != "" {
							<p class="mt-10 border-t border-flag-blue/15 pt-5 text-sm leading-6 text-muted">{ vm.UpdatedNote }</p>
						}
					</div>
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}
