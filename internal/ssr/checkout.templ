package ssr

templ checkoutPage(vm checkoutPageViewModel) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead(vm.Metadata)
		<body class="min-h-screen bg-[#F8F4EE] text-[#17172A] antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main>
				<section class="border-b border-[#2D2A4A]/10 bg-white px-5 py-14 sm:px-8 lg:py-18">
					<div class="mx-auto w-full max-w-7xl">
						<a href="/cart" class="text-sm font-black text-[#A51931] transition hover:text-[#831426]">Back to cart</a>
						<p class="mt-5 text-sm font-black uppercase tracking-wide text-[#A51931]">Review only</p>
						<h1 class="mt-3 text-5xl font-black leading-none text-[#2D2A4A] sm:text-6xl">Checkout Review</h1>
						<p class="mt-5 max-w-3xl text-lg leading-8 text-[#4C4A62]">Confirm your current cart summary. No customer details or payment details are collected here, and no order is submitted.</p>
					</div>
				</section>
				<section class="mx-auto grid w-full max-w-7xl gap-8 px-5 py-14 sm:px-8 lg:grid-cols-[1fr_22rem] lg:items-start lg:py-20">
					<section aria-label="Checkout line items" class="rounded-lg border border-[#2D2A4A]/15 bg-white p-5 shadow-sm sm:p-6">
						<div class="mb-5 flex items-end justify-between gap-4 border-b border-[#2D2A4A]/10 pb-5">
							<div>
								<p class="text-sm font-black uppercase tracking-wide text-[#A51931]">Order summary</p>
								<h2 class="mt-2 text-3xl font-black text-[#2D2A4A] sm:text-4xl">Items in review</h2>
							</div>
							<a href="/products" class="hidden text-sm font-black text-[#A51931] transition hover:text-[#831426] sm:inline">Continue shopping</a>
						</div>
						<div class="grid gap-4">
							for _, line := range vm.Lines {
								<article data-testid="checkout-line-item" class="grid gap-4 rounded-lg border border-[#2D2A4A]/10 bg-[#F8F4EE] p-4 sm:grid-cols-[7rem_1fr]">
									<img class="aspect-[4/3] w-full rounded-md bg-[#F4F5F8] object-cover" src={ line.Product.DisplayImageURL(vm.ProductImagePlaceholderURL) } alt={ line.Product.Name } loading="lazy"/>
									<div class="flex flex-col justify-center">
										<h3 class="text-xl font-black leading-7 text-[#2D2A4A]">{ line.Product.Name }</h3>
										if line.VariantLabel != "" {
											<p class="mt-2 inline-flex w-fit rounded-full bg-white px-3 py-1 text-xs font-black uppercase tracking-wide text-[#2D2A4A]">Size { line.VariantLabel }</p>
										}
										<p class="mt-2 text-sm leading-6 text-[#4C4A62]">Quantity { line.Quantity } at <span class="font-black text-[#A51931]">{ formatPrice(line.Product.PriceCents) }</span> each</p>
										<p class="mt-1 text-sm font-black text-[#2D2A4A]">Line total { formatPrice(lineTotalCents(line)) }</p>
									</div>
								</article>
							}
						</div>
					</section>
					<aside class="rounded-lg border border-[#2D2A4A]/15 bg-white p-6 shadow-sm">
						<p class="text-sm font-black uppercase tracking-wide text-[#A51931]">Review totals</p>
						<div class="mt-5 flex items-center justify-between border-t border-[#2D2A4A]/10 pt-5">
							<p class="text-base font-black text-[#2D2A4A]">Subtotal</p>
							<p class="text-2xl font-black text-[#A51931]">{ formatPrice(subtotalCents(vm.Lines)) }</p>
						</div>
						<div class="mt-5 grid gap-3 text-sm leading-6 text-[#4C4A62]">
							<p>Shipping and tax are not calculated on this review page.</p>
							<p>Payment is not collected, and no order is placed from this screen.</p>
							<p>Return to the cart to adjust quantities or continue browsing products.</p>
						</div>
						<div class="mt-6 grid gap-3">
							<a href="/cart" class="inline-flex h-12 items-center justify-center rounded-full bg-[#A51931] px-6 text-sm font-black text-white shadow-sm transition hover:bg-[#831426] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2D2A4A]">Back to cart</a>
							<a href="/products" class="inline-flex h-12 items-center justify-center rounded-full border border-[#2D2A4A]/20 bg-[#F8F4EE] px-6 text-sm font-black text-[#2D2A4A] transition hover:border-[#A51931]/40">Continue shopping</a>
						</div>
					</aside>
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}
