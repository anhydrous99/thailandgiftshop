package ssr

import "strconv"

templ checkoutPage(vm checkoutPageViewModel) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead(vm.Metadata)
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main id="main-content" tabindex="-1">
				<section class="px-5 pt-10 pb-12 sm:px-8 lg:pt-14 lg:pb-16">
					<div class="mx-auto w-full max-w-7xl">
						@breadcrumbNav(vm.Breadcrumbs)
						<a href="/cart" class="text-sm font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Back to cart</a>
						<p class="mt-5 text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Checkout</p>
						<h1 class="mt-3 font-display text-5xl font-bold leading-none tracking-tight text-flag-blue sm:text-6xl">Checkout</h1>
						<p class="mt-5 max-w-3xl text-lg leading-8 text-muted">Payment is processed by Stripe. We never see or store your card number. Shipping is free while we launch; tax is not collected yet.</p>
					</div>
				</section>
				@flagBand("h-3")
				<section class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-8 lg:py-16">
					if vm.Canceled {
						<p role="status" data-testid="checkout-canceled-notice" class="mb-8 alert-success">Payment canceled. Your cart is unchanged — continue whenever you are ready.</p>
					}
					if vm.ErrorMessage != "" {
						<p role="alert" data-testid="checkout-error" class="mb-8 alert-error">{ vm.ErrorMessage }</p>
					}
					if vm.Guest {
						<form method="post" action="/checkout/place-order" data-testid="guest-checkout-form">
							<input type="hidden" name="guest_csrf_token" value={ vm.CSRFToken }/>
							<div class="grid gap-8 lg:grid-cols-[1fr_22rem] lg:items-start">
								<div class="grid gap-8">
									<section aria-label="Contact" class="border-2 border-ink bg-paper">
										@flagBand("h-1.5")
										<div class="p-6">
											<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Contact</p>
											<h2 class="mt-2 font-display text-2xl font-bold tracking-tight text-flag-blue">Where should the receipt go?</h2>
											<p class="mt-3 text-sm leading-6 text-muted">Check out as a guest — no account needed. Stripe emails your receipt here.</p>
											<label class="mt-5 grid gap-2 text-xs font-medium text-muted">
												Email
												<input type="email" name="email" value={ vm.GuestEmail } autocomplete="email" required data-testid="guest-email-input" class="field-input h-12 text-base"/>
											</label>
											<p class="mt-4 text-sm leading-6 text-muted">Have an account? <a href="/account/sign-in?return_to=%2Fcheckout" data-testid="checkout-sign-in-link" class="font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Sign in</a></p>
										</div>
									</section>
									<section aria-label="Shipping address" class="border-2 border-ink bg-paper">
										@flagBand("h-1.5")
										<div class="p-6">
											<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Shipping address</p>
											<h2 class="mt-2 font-display text-2xl font-bold tracking-tight text-flag-blue">Where is this order going?</h2>
											<p class="mt-3 text-sm leading-6 text-muted">US addresses only while we launch.</p>
											<div class="mt-5 grid gap-4">
												@addressFormFields(vm.AddressForm)
											</div>
										</div>
									</section>
									@checkoutItemsSection(vm)
								</div>
								@checkoutSummaryAside(vm, true)
							</div>
						</form>
					} else if len(vm.Addresses) == 0 {
						<div class="grid gap-8 lg:grid-cols-[1fr_22rem] lg:items-start">
							<div class="grid gap-8">
								<section aria-label="Shipping address" class="border-2 border-ink bg-paper">
									@flagBand("h-1.5")
									<div class="p-6">
										<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Shipping address</p>
										<h2 class="mt-2 font-display text-2xl font-bold tracking-tight text-flag-blue">Add an address to continue</h2>
										<p class="mt-3 text-sm leading-6 text-muted">Save the shipping address for this order. US addresses only while we launch.</p>
										<form method="post" action="/account/addresses" data-testid="address-form" class="mt-5 grid gap-4">
											<input type="hidden" name="csrf_token" value={ vm.CSRFToken }/>
											<input type="hidden" name="next" value="/checkout"/>
											@addressFormFields(addressFormData{})
											<button type="submit" class="inline-flex h-12 items-center justify-center bg-flag-red px-6 text-sm font-bold text-white transition hover:bg-flag-red-deep">Save address</button>
										</form>
									</div>
								</section>
								@checkoutItemsSection(vm)
							</div>
							@checkoutSummaryAside(vm, false)
						</div>
					} else {
						<form method="post" action="/checkout/place-order">
							<input type="hidden" name="csrf_token" value={ vm.CSRFToken }/>
							<div class="grid gap-8 lg:grid-cols-[1fr_22rem] lg:items-start">
								<div class="grid gap-8">
									<section aria-label="Shipping address" class="border border-flag-blue/15 bg-paper p-5 sm:p-6">
										<div class="mb-5 flex items-end justify-between gap-4 border-b border-flag-blue/10 pb-5">
											<div>
												<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Shipping address</p>
												<h2 class="mt-2 font-display text-2xl font-bold tracking-tight text-flag-blue">Ship this order to</h2>
											</div>
											<a href="/account/addresses?next=/checkout" class="text-sm font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Manage addresses</a>
										</div>
										<div class="grid gap-3">
											for _, address := range vm.Addresses {
												<label data-testid="checkout-address-option" class="grid cursor-pointer grid-cols-[auto_1fr] items-start gap-4 border border-flag-blue/15 bg-flag-white p-4 transition hover:border-flag-blue has-checked:border-flag-blue has-checked:bg-paper">
													if address.ID == vm.SelectedAddress {
														<input type="radio" name="address_id" value={ address.ID } checked class="mt-1 h-4 w-4 accent-flag-red"/>
													} else {
														<input type="radio" name="address_id" value={ address.ID } class="mt-1 h-4 w-4 accent-flag-red"/>
													}
													<span class="text-sm leading-6 text-muted">
														<span class="block font-display text-lg font-bold text-flag-blue">
															{ address.FullName }
															if address.IsDefault {
																<span class="ml-2 inline-flex bg-flag-blue px-2.5 py-1 align-middle text-xs font-semibold text-white">Default</span>
															}
														</span>
														<span class="block">{ address.Line1 }</span>
														if address.Line2 != "" {
															<span class="block">{ address.Line2 }</span>
														}
														<span class="block">{ address.City }, { address.Region } { address.PostalCode }</span>
													</span>
												</label>
											}
										</div>
									</section>
									@checkoutItemsSection(vm)
								</div>
								@checkoutSummaryAside(vm, true)
							</div>
						</form>
					}
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}

// checkoutItemsSection lists the priced order lines shared by both checkout
// layouts (with and without saved addresses).
templ checkoutItemsSection(vm checkoutPageViewModel) {
	<section aria-label="Order items" class="border border-flag-blue/15 bg-paper p-5 sm:p-6">
		<div class="mb-5 flex items-end justify-between gap-4 border-b border-flag-blue/10 pb-5">
			<div>
				<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Order summary</p>
				<h2 class="mt-2 font-display text-2xl font-bold tracking-tight text-flag-blue">Items in this order</h2>
			</div>
			<a href="/cart" class="hidden text-sm font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4 sm:inline">Edit cart</a>
		</div>
		<div class="grid gap-4">
			for _, line := range vm.Lines {
				<article data-testid="checkout-line-item" class="grid gap-4 border border-flag-blue/10 bg-flag-white p-4 sm:grid-cols-[7rem_1fr]">
					<img class="aspect-[4/3] w-full bg-paper object-cover" src={ line.ImageURL } alt={ line.Name } loading="lazy"/>
					<div class="flex flex-col justify-center">
						<h3 class="font-display text-xl font-medium leading-7 text-flag-blue">{ line.Name }</h3>
						if line.VariantLabel != "" {
							<p class="mt-2 inline-flex w-fit bg-paper px-2.5 py-1 text-xs font-semibold text-flag-blue">Size { line.VariantLabel }</p>
						}
						if line.Notice != "" {
							<p data-testid="checkout-line-notice" class="mt-3 alert-error">{ line.Notice }</p>
						}
						<p class="mt-2 text-sm leading-6 text-muted">Quantity { strconv.Itoa(line.Quantity) } at <span class="font-bold tabular-nums text-flag-red">{ line.UnitPrice }</span> each</p>
						<p class="mt-1 text-sm font-bold tabular-nums text-flag-blue">Line total { line.LineTotal }</p>
					</div>
				</article>
			}
		</div>
	</section>
}

// checkoutSummaryAside is the dark totals card; showPlaceOrder gates the
// submit button on having a saved address to ship to.
templ checkoutSummaryAside(vm checkoutPageViewModel, showPlaceOrder bool) {
	<aside class="border border-flag-blue bg-flag-blue text-white">
		@flagBand("h-1.5")
		<div class="p-6">
			<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-white">Order total</p>
			<div class="mt-5 grid gap-2 border-t border-white/15 pt-5 text-sm leading-6 text-white/70">
				<p class="flex items-center justify-between">Subtotal <span class="font-bold tabular-nums text-white">{ vm.Subtotal }</span></p>
				<p class="flex items-center justify-between">Shipping <span class="font-bold text-white">Free</span></p>
				<p class="flex items-center justify-between">Tax <span class="font-bold text-white">$0.00</span></p>
			</div>
			<div class="mt-5 flex items-center justify-between border-t border-white/15 pt-5">
				<p class="text-base font-bold text-white">Total</p>
				<p class="font-display text-3xl font-bold tabular-nums text-white">{ vm.Total }</p>
			</div>
			<div class="mt-6 grid gap-3">
				if showPlaceOrder {
					<button type="submit" data-testid="place-order-button" class="inline-flex h-12 items-center justify-center bg-flag-red px-6 text-sm font-bold text-white transition hover:bg-flag-red-deep focus-visible:outline-white">Continue to payment</button>
				} else {
					<p class="border-l-4 border-white/60 bg-white/10 px-4 py-3 text-sm font-semibold leading-6 text-white">Save a shipping address to continue to payment.</p>
				}
				<a href="/cart" class="inline-flex h-12 items-center justify-center border-2 border-white/60 px-6 text-sm font-bold text-white transition hover:bg-white hover:text-flag-blue focus-visible:outline-white">Back to cart</a>
			</div>
			<p class="mt-5 text-sm leading-6 text-white/70">You enter card details on Stripe's secure page. We never see or store card numbers.</p>
		</div>
	</aside>
}

// checkoutPaymentReceivedPage is shown when a payment landed for an order
// already in a terminal status (canceled/expired before the payment settled):
// the customer was charged, so the page acknowledges the payment and explains
// that a refund is being issued automatically instead of erroring.
templ checkoutPaymentReceivedPage(vm checkoutProcessingPageData) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead(vm.Metadata)
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main id="main-content" tabindex="-1">
				<section class="mx-auto w-full max-w-7xl px-5 py-16 sm:px-8">
					<div data-testid="checkout-payment-received" class="mx-auto max-w-xl border-2 border-ink bg-paper">
						@flagBand("h-1.5")
						<div class="p-8 text-center">
							<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Checkout</p>
							<h1 class="mt-3 font-display text-3xl font-bold tracking-tight text-flag-blue">Payment received</h1>
							<p class="mt-4 text-sm leading-6 text-muted">Your payment went through, but this order had already been canceled before the payment settled, so it will not ship. A refund is being issued automatically to your original payment method. If it has not arrived within a few days, contact us at <a href="mailto:support@thailandgiftshop.com" class="font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">support@thailandgiftshop.com</a> with order { vm.OrderID }.</p>
							<p class="mt-4 text-sm leading-6 text-muted">Your cart is unchanged, so you can <a href="/checkout" class="font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">place the order again</a> whenever you are ready.</p>
						</div>
					</div>
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}

// checkoutProcessingPage is the no-JS interstitial shown while an off-session
// payment settles; the meta refresh re-runs the confirm reconcile.
templ checkoutProcessingPage(vm checkoutProcessingPageData) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta http-equiv="refresh" content="3"/>
			<title>{ vm.Metadata.Title }</title>
			<meta name="description" content={ vm.Metadata.Description }/>
			<meta name="robots" content="noindex, follow"/>
			<link rel="icon" href="/static/favicon.ico" sizes="any"/>
			<link rel="stylesheet" href="/static/assets/app.css"/>
		</head>
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main id="main-content" tabindex="-1">
				<section class="mx-auto w-full max-w-7xl px-5 py-16 sm:px-8">
					<div data-testid="checkout-processing" class="mx-auto max-w-xl border-2 border-ink bg-paper">
						@flagBand("h-1.5")
						<div class="p-8 text-center">
							<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Checkout</p>
							<h1 class="mt-3 font-display text-3xl font-bold tracking-tight text-flag-blue">Payment processing</h1>
							<p class="mt-4 text-sm leading-6 text-muted">Stripe is confirming your payment. This page refreshes on its own — leave it open and your order appears as soon as the payment settles.</p>
							if vm.OrderID != "" {
								<p class="mt-4 text-sm leading-6 text-muted">You can also check <a href={ "/orders/" + vm.OrderID } class="font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">your order page</a> directly.</p>
							}
						</div>
					</div>
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}
