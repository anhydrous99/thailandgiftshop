package ssr

templ checkoutPage(vm checkoutPageViewModel) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead(vm.Metadata)
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main>
				<section class="px-5 pt-10 pb-12 sm:px-8 lg:pt-14 lg:pb-16">
					<div class="mx-auto w-full max-w-7xl">
						<a href="/cart" class="text-sm font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Back to cart</a>
						<p class="mt-5 text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Review only</p>
						<h1 class="mt-3 font-display text-5xl font-bold leading-none tracking-tight text-flag-blue sm:text-6xl">Checkout Review</h1>
						<p class="mt-5 max-w-3xl text-lg leading-8 text-muted">Confirm your current cart summary. No customer details or payment details are collected here, and no order is submitted.</p>
					</div>
				</section>
				@flagBand("h-3")
				<section class="mx-auto grid w-full max-w-7xl gap-8 px-5 py-12 sm:px-8 lg:grid-cols-[1fr_22rem] lg:items-start lg:py-16">
					<section aria-label="Checkout line items" class="border border-flag-blue/15 bg-paper p-5 sm:p-6">
						<div class="mb-5 flex items-end justify-between gap-4 border-b border-flag-blue/10 pb-5">
							<div>
								<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Order summary</p>
								<h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-flag-blue sm:text-4xl">Items in review</h2>
							</div>
							<a href="/products" class="hidden text-sm font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4 sm:inline">Continue shopping</a>
						</div>
						<div class="grid gap-4">
							for _, line := range vm.Lines {
								<article data-testid="checkout-line-item" class="grid gap-4 border border-flag-blue/10 bg-flag-white p-4 sm:grid-cols-[7rem_1fr]">
									<img class="aspect-[4/3] w-full bg-paper object-cover" src={ line.Product.DisplayImageURL(vm.ProductImagePlaceholderURL) } alt={ line.Product.Name } loading="lazy"/>
									<div class="flex flex-col justify-center">
										<h3 class="font-display text-xl font-medium leading-7 text-flag-blue">{ line.Product.Name }</h3>
										if line.VariantLabel != "" {
											<p class="mt-2 inline-flex w-fit bg-paper px-2.5 py-1 text-xs font-semibold text-flag-blue">Size { line.VariantLabel }</p>
										}
										<p class="mt-2 text-sm leading-6 text-muted">Quantity { line.Quantity } at <span class="font-bold tabular-nums text-flag-red">{ formatPrice(line.Product.PriceCents) }</span> each</p>
										<p class="mt-1 text-sm font-bold tabular-nums text-flag-blue">Line total { formatPrice(lineTotalCents(line)) }</p>
									</div>
								</article>
							}
						</div>
					</section>
					<aside class="border border-flag-blue bg-flag-blue text-white">
						@flagBand("h-1.5")
						<div class="p-6">
							<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-white">Review totals</p>
							<div class="mt-5 flex items-center justify-between border-t border-white/15 pt-5">
								<p class="text-base font-bold text-white">Subtotal</p>
								<p class="font-display text-3xl font-bold tabular-nums text-white">{ formatPrice(subtotalCents(vm.Lines)) }</p>
							</div>
							<div class="mt-5 grid gap-3 text-sm leading-6 text-white/70">
								<p>Shipping and tax are not calculated on this review page.</p>
								<p>Payment is not collected, and no order is placed from this screen.</p>
								<p>Return to the cart to adjust quantities or continue browsing products.</p>
							</div>
							<div class="mt-6 grid gap-3">
								<a href="/cart" class="inline-flex h-12 items-center justify-center bg-flag-red px-6 text-sm font-bold text-white transition hover:bg-flag-red-deep focus-visible:outline-white">Back to cart</a>
								<a href="/products" class="inline-flex h-12 items-center justify-center border-2 border-white/60 px-6 text-sm font-bold text-white transition hover:bg-white hover:text-flag-blue focus-visible:outline-white">Continue shopping</a>
							</div>
						</div>
					</aside>
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}
