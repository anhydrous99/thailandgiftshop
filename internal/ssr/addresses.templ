package ssr

templ addressFormFields(form addressFormData) {
	<label class="grid gap-2 text-xs font-medium text-muted">
		Full name
		<input type="text" name="full_name" value={ form.FullName } autocomplete="name" required class="field-input h-12 text-base"/>
	</label>
	<label class="grid gap-2 text-xs font-medium text-muted">
		Address line 1
		<input type="text" name="line1" value={ form.Line1 } autocomplete="address-line1" required class="field-input h-12 text-base"/>
	</label>
	<label class="grid gap-2 text-xs font-medium text-muted">
		Address line 2 (optional)
		<input type="text" name="line2" value={ form.Line2 } autocomplete="address-line2" class="field-input h-12 text-base"/>
	</label>
	<div class="grid gap-4 sm:grid-cols-3">
		<label class="grid gap-2 text-xs font-medium text-muted">
			City
			<input type="text" name="city" value={ form.City } autocomplete="address-level2" required class="field-input h-12 text-base"/>
		</label>
		<label class="grid gap-2 text-xs font-medium text-muted">
			State
			<input type="text" name="region" value={ form.Region } autocomplete="address-level1" required class="field-input h-12 text-base"/>
		</label>
		<label class="grid gap-2 text-xs font-medium text-muted">
			ZIP code
			<input type="text" name="postal_code" value={ form.PostalCode } autocomplete="postal-code" required class="field-input h-12 text-base"/>
		</label>
	</div>
	<label class="grid gap-2 text-xs font-medium text-muted">
		Phone (optional)
		<input type="tel" name="phone" value={ form.Phone } autocomplete="tel" class="field-input h-12 text-base"/>
	</label>
	<p class="text-xs font-medium text-muted">Country: United States (US only while we launch)</p>
}

templ addressesPage(vm addressesPageData) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead(vm.Metadata)
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main id="main-content" tabindex="-1">
				<section class="px-5 pt-10 pb-12 sm:px-8 lg:pt-14 lg:pb-16">
					<div class="mx-auto w-full max-w-7xl">
						@breadcrumbNav(vm.Breadcrumbs)
						<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Account</p>
						<h1 class="mt-3 font-display text-5xl font-bold leading-none tracking-tight text-flag-blue sm:text-6xl">Addresses</h1>
						<p class="mt-5 max-w-3xl text-lg leading-8 text-muted">Save the shipping addresses you use for orders. US addresses only while we launch.</p>
					</div>
				</section>
				@flagBand("h-3")
				<section class="mx-auto grid w-full max-w-7xl gap-8 px-5 py-12 sm:px-8 lg:grid-cols-[1fr_22rem] lg:items-start lg:py-16">
					<section aria-label="Saved addresses" class="grid gap-4">
						if len(vm.Addresses) == 0 {
							<section class="border-2 border-dashed border-flag-blue/25 bg-paper p-10 text-center">
								<div class="mx-auto w-16">
									@flagBand("h-1.5")
								</div>
								<h2 class="mt-5 font-display text-xl font-bold text-flag-blue">No addresses yet.</h2>
								<p class="mt-2 text-sm leading-6 text-muted">Add a shipping address to speed up checkout.</p>
							</section>
						}
						for _, address := range vm.Addresses {
							<article data-testid="address-row" class="grid gap-4 border border-flag-blue/15 bg-paper p-5 sm:grid-cols-[1fr_auto] sm:items-start">
								<div class="text-sm leading-6 text-muted">
									<p class="font-display text-lg font-bold text-flag-blue">
										{ address.FullName }
										if address.IsDefault {
											<span class="ml-2 inline-flex bg-flag-blue px-2.5 py-1 align-middle text-xs font-semibold text-white">Default</span>
										}
									</p>
									<p>{ address.Line1 }</p>
									if address.Line2 != "" {
										<p>{ address.Line2 }</p>
									}
									<p>{ address.City }, { address.Region } { address.PostalCode }</p>
									if address.Phone != "" {
										<p>Phone { address.Phone }</p>
									}
								</div>
								<div class="grid gap-3 sm:min-w-40">
									<a href={ "/account/addresses/" + address.ID + "/edit" } class="inline-flex h-11 items-center justify-center border-2 border-ink bg-paper px-4 text-sm font-bold text-ink transition hover:border-flag-red hover:text-flag-red">Edit</a>
									if !address.IsDefault {
										<form method="post" action={ "/account/addresses/" + address.ID + "/default" }>
											<input type="hidden" name="csrf_token" value={ vm.CSRFToken }/>
											<button type="submit" class="inline-flex h-11 w-full items-center justify-center bg-flag-blue px-4 text-sm font-bold text-white transition hover:bg-ink">Make default</button>
										</form>
									}
									<form method="post" action={ "/account/addresses/" + address.ID + "/remove" }>
										<input type="hidden" name="csrf_token" value={ vm.CSRFToken }/>
										<button type="submit" class="text-sm font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Remove</button>
									</form>
								</div>
							</article>
						}
					</section>
					<aside class="border-2 border-ink bg-paper">
						@flagBand("h-1.5")
						<div class="p-6">
							<h2 class="font-display text-2xl font-bold tracking-tight text-flag-blue">Add an address</h2>
							if vm.AtLimit {
								<p class="mt-4 alert-error">You can save up to 10 addresses. Remove one to add another.</p>
							} else {
								if vm.Form.ErrorMessage != "" {
									<p role="alert" class="mt-4 alert-error">{ vm.Form.ErrorMessage }</p>
								}
								<form method="post" action="/account/addresses" data-testid="address-form" class="mt-5 grid gap-4">
									<input type="hidden" name="csrf_token" value={ vm.CSRFToken }/>
									if vm.Next != "" {
										<input type="hidden" name="next" value={ vm.Next }/>
									}
									@addressFormFields(vm.Form)
									<button type="submit" class="inline-flex h-12 items-center justify-center bg-flag-red px-6 text-sm font-bold text-white transition hover:bg-flag-red-deep">Save address</button>
								</form>
							}
						</div>
					</aside>
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}
