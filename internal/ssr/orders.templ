package ssr

import "strconv"

templ ordersPage(vm ordersPageData) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead(vm.Metadata)
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main id="main-content" tabindex="-1">
				<section class="px-5 pt-10 pb-12 sm:px-8 lg:pt-14 lg:pb-16">
					<div class="mx-auto w-full max-w-7xl">
						@breadcrumbNav(vm.Breadcrumbs)
						<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Account</p>
						<h1 class="mt-3 font-display text-5xl font-bold leading-none tracking-tight text-flag-blue sm:text-6xl">Orders</h1>
						<p class="mt-5 max-w-3xl text-lg leading-8 text-muted">Every order you place appears here with its current status and tracking.</p>
					</div>
				</section>
				@flagBand("h-3")
				<section class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-8 lg:py-16">
					if len(vm.Orders) == 0 {
						<section class="border-2 border-dashed border-flag-blue/25 bg-paper p-10 text-center">
							<div class="mx-auto w-16">
								@flagBand("h-1.5")
							</div>
							<h2 class="mt-5 font-display text-xl font-bold text-flag-blue">No orders yet.</h2>
							<p class="mt-2 text-sm leading-6 text-muted">Browse the latest Thai snacks, souvenirs, pantry favorites, and small keepsakes to place your first order.</p>
							<a href="/products" class="mt-6 inline-flex h-12 items-center justify-center bg-flag-red px-6 text-sm font-bold text-white transition hover:bg-flag-red-deep">Continue shopping</a>
						</section>
					} else {
						<div class="grid gap-4">
							for _, order := range vm.Orders {
								<a data-testid="order-row" href={ "/orders/" + order.ID } class="grid gap-3 border border-flag-blue/15 bg-paper p-5 transition hover:border-flag-blue sm:grid-cols-[1fr_auto_auto] sm:items-center">
									<span>
										<span class="block font-display text-lg font-bold text-flag-blue">Order { order.ID }</span>
										<span class="mt-1 block text-sm leading-6 text-muted">
											Placed { order.PlacedAt }
											if order.ItemCount == 1 {
												· 1 item
											} else {
												· { strconv.Itoa(order.ItemCount) } items
											}
										</span>
									</span>
									<span class="inline-flex w-fit border border-flag-blue/20 bg-flag-white px-2.5 py-1 text-xs font-semibold text-flag-blue">{ order.StatusLabel }</span>
									<span class="text-sm font-bold tabular-nums text-flag-red">{ order.Total }</span>
								</a>
							}
						</div>
						if vm.NextCursor != "" {
							<div class="mt-8">
								<a data-testid="orders-next-page" href={ "/orders?after=" + vm.NextCursor } class="inline-flex h-12 items-center justify-center border-2 border-ink bg-paper px-6 text-sm font-bold text-ink transition hover:border-flag-red hover:text-flag-red">Older orders</a>
							</div>
						}
					}
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}
