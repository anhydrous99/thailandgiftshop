package ssr

import "strconv"

templ orderDetailPage(vm orderDetailPageData) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead(vm.Metadata)
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main id="main-content" tabindex="-1">
				<section class="px-5 pt-10 pb-12 sm:px-8 lg:pt-14 lg:pb-16">
					<div class="mx-auto w-full max-w-7xl">
						@breadcrumbNav(vm.Breadcrumbs)
						if !vm.Guest {
							<a href="/orders" class="text-sm font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Back to orders</a>
						}
						<p class="mt-5 text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Order</p>
						<h1 class="mt-3 break-all font-display text-4xl font-bold leading-tight tracking-tight text-flag-blue sm:text-5xl">Order { vm.OrderID }</h1>
						<p class="mt-4 flex flex-wrap items-center gap-3">
							<span data-testid="order-status" class="inline-flex border border-flag-blue/20 bg-flag-white px-2.5 py-1 text-xs font-semibold text-flag-blue">{ vm.StatusLabel }</span>
							if vm.PlacedAt != "" {
								<span class="text-sm leading-6 text-muted">Placed { vm.PlacedAt }</span>
							}
						</p>
					</div>
				</section>
				@flagBand("h-3")
				<section class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-8 lg:py-16">
					if vm.Placed {
						<p role="status" data-testid="order-placed-banner" class="mb-8 alert-success">
							Thank you — your order is placed. Stripe handled your payment securely; we never see or store card numbers.
							if vm.Guest {
								<a href="/account/sign-up" data-testid="guest-signup-upsell" class="font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Create an account</a> to keep your orders in one place next time.
							}
							<span class="mt-2 block"><a href="/products" data-testid="order-continue-shopping-link" class="font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Continue shopping</a>.</span>
						</p>
					}
					if vm.Guest {
						<p role="status" data-testid="guest-order-link-notice" class="mb-8 alert-success">
							Save this private link to check on your order any time in the next 30 days:
							<a href={ templ.SafeURL(vm.GuestAccessURL) } class="font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">this order's status page</a>.
							Stripe has emailed your receipt.
						</p>
					}
					<div class="grid gap-8 lg:grid-cols-[1fr_22rem] lg:items-start">
						<div class="grid gap-8">
							<section aria-label="Order items" class="border border-flag-blue/15 bg-paper p-5 sm:p-6">
								<h2 class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Items</h2>
								<div class="mt-3 grid gap-4">
									for _, line := range vm.Lines {
										<article data-testid="order-line-item" class="grid gap-4 border border-flag-blue/10 bg-flag-white p-4 sm:grid-cols-[7rem_1fr]">
											@productImagePicture(line.ImageURL, line.Name, "aspect-[4/3] w-full bg-paper object-cover", "(min-width: 640px) 7rem, 100vw", "lazy", "")
											<div class="flex flex-col justify-center">
												<h3 class="font-display text-xl font-medium leading-7 text-flag-blue">{ line.Name }</h3>
												if line.VariantLabel != "" {
													<p class="mt-2 inline-flex w-fit bg-paper px-2.5 py-1 text-xs font-semibold text-flag-blue">Size { line.VariantLabel }</p>
												}
												<p class="mt-2 text-sm leading-6 text-muted">Quantity { strconv.Itoa(line.Quantity) } at <span class="font-bold tabular-nums text-flag-red">{ line.UnitPrice }</span> each</p>
												<p class="mt-1 text-sm font-bold tabular-nums text-flag-blue">Line total { line.LineTotal }</p>
											</div>
										</article>
									}
								</div>
							</section>
							<section aria-label="Order status history" class="border border-flag-blue/15 bg-paper p-5 sm:p-6">
								<h2 class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Status timeline</h2>
								<ol data-testid="order-timeline" class="mt-3 grid gap-2">
									for _, step := range vm.Timeline {
										<li data-testid="order-timeline-step" class="flex flex-wrap items-center gap-3 border border-flag-blue/10 bg-flag-white px-4 py-3 text-sm leading-6">
											<span aria-hidden="true" class="h-2.5 w-2.5 shrink-0 bg-flag-red"></span>
											<span class="font-semibold text-flag-blue">{ step.StatusLabel }</span>
											<span class="text-muted">{ step.At }</span>
										</li>
									}
								</ol>
							</section>
						</div>
						<aside class="border border-flag-blue bg-flag-blue text-white">
							@flagBand("h-1.5")
							<div class="p-6">
								<h2 class="text-xs font-semibold uppercase tracking-eyebrow text-flag-white">Order total</h2>
								<dl class="mt-5 grid gap-2 border-t border-white/15 pt-5 text-sm leading-6 text-white/70">
									<div class="flex items-center justify-between"><dt>Subtotal</dt><dd class="font-bold tabular-nums text-white">{ vm.Subtotal }</dd></div>
									<div class="flex items-center justify-between"><dt>Shipping</dt><dd class="font-bold tabular-nums text-white">{ vm.Shipping }</dd></div>
									<div class="flex items-center justify-between"><dt>Tax</dt><dd class="font-bold tabular-nums text-white">{ vm.Tax }</dd></div>
									<div class="flex items-center justify-between border-t border-white/15 pt-2"><dt class="text-base font-bold text-white">Total</dt><dd class="font-display text-2xl font-bold tabular-nums text-white">{ vm.Total }</dd></div>
								</dl>
								if vm.CardLast4 != "" {
									<p class="mt-4 text-sm leading-6 text-white/70">Paid with { vm.CardBrand } •••• { vm.CardLast4 }</p>
								}
								<div class="mt-6 border-t border-white/15 pt-5">
									<h3 class="text-xs font-semibold uppercase tracking-eyebrow text-flag-white">Ships to</h3>
									<address class="mt-3 text-sm not-italic leading-6 text-white/90">
										<p class="font-semibold text-white">{ vm.Address.FullName }</p>
										<p>{ vm.Address.Line1 }</p>
										if vm.Address.Line2 != "" {
											<p>{ vm.Address.Line2 }</p>
										}
										<p>{ vm.Address.City }, { vm.Address.Region } { vm.Address.PostalCode }</p>
										<p>{ vm.Address.Country }</p>
									</address>
								</div>
								if vm.TrackingCarrier != "" || vm.TrackingNumber != "" {
									<div class="mt-6 border-t border-white/15 pt-5">
										<h3 class="text-xs font-semibold uppercase tracking-eyebrow text-flag-white">Tracking</h3>
										<p data-testid="order-tracking" class="mt-3 break-all text-sm leading-6 text-white">{ vm.TrackingCarrier } { vm.TrackingNumber }</p>
									</div>
								}
							</div>
						</aside>
					</div>
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}
