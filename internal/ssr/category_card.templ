package ssr

import "github.com/anhydrous99/thailandgiftshop/internal/catalog"

templ categoryCard(category catalog.Category) {
	<a data-testid="category-card" href={ "/categories/" + category.Slug } class="block border border-flag-blue/15 bg-paper p-5 transition hover:border-flag-blue hover:shadow-lift">
		<span class="block border-l-2 border-flag-red pl-4">
			<span class="block font-display text-base font-medium text-flag-blue">{ category.Name }</span>
			<span class="mt-2 block text-sm leading-6 text-muted">{ category.Description }</span>
		</span>
	</a>
}
