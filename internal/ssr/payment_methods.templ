package ssr

templ paymentMethodsPage(vm paymentMethodsPageData) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHeadWithOptions(vm.Metadata, siteHeadOptions{Enhance: true})
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main id="main-content" tabindex="-1">
				<section class="px-5 pt-10 pb-12 sm:px-8 lg:pt-14 lg:pb-16">
					<div class="mx-auto w-full max-w-7xl">
						@breadcrumbNav(vm.Breadcrumbs)
						<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Account</p>
						<h1 class="mt-3 font-display text-5xl font-bold leading-none tracking-tight text-flag-blue sm:text-6xl">Saved cards</h1>
						<p class="mt-5 max-w-3xl text-lg leading-8 text-muted">Cards are stored securely by Stripe. We never see or store card numbers — only the brand, last four digits, and expiry shown here.</p>
					</div>
				</section>
				@flagBand("h-3")
				<section class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-8 lg:py-16">
					if vm.Saved {
						<p role="status" class="mb-8 alert-success">Card saved.</p>
					}
					<div class="grid gap-8 lg:grid-cols-[1fr_22rem] lg:items-start">
						<section aria-label="Saved cards" class="grid gap-4">
							if len(vm.Methods) == 0 {
								<section class="border-2 border-dashed border-flag-blue/25 bg-paper p-10 text-center">
									<div class="mx-auto w-16">
										@flagBand("h-1.5")
									</div>
									<h2 class="mt-5 font-display text-xl font-bold text-flag-blue">No saved cards yet.</h2>
									<p class="mt-2 text-sm leading-6 text-muted">Save a card during checkout, or add one here through Stripe.</p>
								</section>
							}
							for _, method := range vm.Methods {
								<article data-testid="payment-method-row" class="grid gap-4 border border-flag-blue/15 bg-paper p-5 sm:grid-cols-[1fr_auto] sm:items-center">
									<div>
										<p class="font-display text-lg font-bold text-flag-blue">{ method.Brand } •••• { method.Last4 }</p>
										if method.Expiry != "" {
											<p class="mt-1 text-sm leading-6 text-muted">Expires { method.Expiry }</p>
										}
									</div>
									<form method="post" action={ "/account/payment-methods/" + method.ID + "/remove" } data-confirm="Remove this card? You can add it again later." data-confirm-title="Remove card?" data-confirm-label="Remove card">
										<input type="hidden" name="csrf_token" value={ vm.CSRFToken }/>
										<button type="submit" class="text-sm font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Remove</button>
									</form>
								</article>
							}
						</section>
						<aside class="border-2 border-ink bg-paper">
							@flagBand("h-1.5")
							<div class="p-6">
								<h2 class="font-display text-2xl font-bold tracking-tight text-flag-blue">Add a card</h2>
								<p class="mt-3 text-sm leading-6 text-muted">You will be sent to Stripe to enter card details. Nothing is charged when saving a card.</p>
								<form method="post" action="/account/payment-methods/add" class="mt-5">
									<input type="hidden" name="csrf_token" value={ vm.CSRFToken }/>
									<button type="submit" class="inline-flex h-12 w-full items-center justify-center bg-flag-red px-6 text-sm font-bold text-white transition hover:bg-flag-red-deep">Add a card</button>
								</form>
							</div>
						</aside>
					</div>
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
			@confirmDialog()
		</body>
	</html>
}
