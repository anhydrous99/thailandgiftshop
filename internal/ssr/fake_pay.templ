package ssr

templ fakePayPage(vm fakePayPageData) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead(vm.Metadata)
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main id="main-content" tabindex="-1">
				<section class="mx-auto w-full max-w-7xl px-5 py-16 sm:px-8">
					<div class="mx-auto max-w-xl border-2 border-ink bg-paper">
						@flagBand("h-1.5")
						<div class="p-8">
							<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Demo payment — no real charge</p>
							if vm.SetupMode {
								<h1 class="mt-3 font-display text-3xl font-bold tracking-tight text-flag-blue">Save a demo card</h1>
								<p class="mt-4 text-sm leading-6 text-muted">This stands in for Stripe's hosted page in local demo runs. Completing it saves the fixed demo card (visa •••• 4242) — nothing is charged and no real card exists.</p>
							} else {
								<h1 class="mt-3 font-display text-3xl font-bold tracking-tight text-flag-blue">Pay { vm.Total }</h1>
								<p class="mt-4 text-sm leading-6 text-muted">This stands in for Stripe's hosted payment page in local demo runs. Paying marks the order paid with the fixed demo card (visa •••• 4242) — no real charge is made.</p>
							}
							<form method="post" action="/checkout/fake-pay" class="mt-6 grid gap-4">
								if vm.Guest {
									<input type="hidden" name="guest_csrf_token" value={ vm.CSRFToken }/>
								} else {
									<input type="hidden" name="csrf_token" value={ vm.CSRFToken }/>
								}
								<input type="hidden" name="session_id" value={ vm.SessionID }/>
								<input type="hidden" name="action" value="pay"/>
								if !vm.SetupMode {
									if !vm.Guest {
										<label class="flex items-center gap-3 text-sm font-medium text-ink">
											<input type="checkbox" name="save_card" value="1" class="h-4 w-4 accent-flag-red"/>
											Save this card for next time
										</label>
									}
									<button type="submit" data-testid="fake-pay-button" class="inline-flex h-12 items-center justify-center bg-flag-red px-6 text-sm font-bold text-white transition hover:bg-flag-red-deep">Pay { vm.Total }</button>
								} else {
									<button type="submit" data-testid="fake-pay-button" class="inline-flex h-12 items-center justify-center bg-flag-red px-6 text-sm font-bold text-white transition hover:bg-flag-red-deep">Save card</button>
								}
							</form>
							<form method="post" action="/checkout/fake-pay" class="mt-3">
								if vm.Guest {
									<input type="hidden" name="guest_csrf_token" value={ vm.CSRFToken }/>
								} else {
									<input type="hidden" name="csrf_token" value={ vm.CSRFToken }/>
								}
								<input type="hidden" name="session_id" value={ vm.SessionID }/>
								<input type="hidden" name="action" value="cancel"/>
								<button type="submit" data-testid="fake-pay-cancel" class="inline-flex h-12 w-full items-center justify-center border-2 border-ink bg-paper px-6 text-sm font-bold text-ink transition hover:border-flag-red hover:text-flag-red">Cancel</button>
							</form>
						</div>
					</div>
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}
