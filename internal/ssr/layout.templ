package ssr


import (
	"strconv"

	"github.com/anhydrous99/thailandgiftshop/internal/staticassets"
)

type siteHeadOptions struct {
	Enhance bool
}

templ siteHead(metadata seoMetadata) {
	@siteHeadWithOptions(metadata, siteHeadOptions{})
}

templ siteHeadWithOptions(metadata seoMetadata, options siteHeadOptions) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ metadata.Title }</title>
		<meta name="description" content={ metadata.Description }/>
		if metadata.Robots != "" {
			<meta name="robots" content={ metadata.Robots }/>
		}
		<link rel="canonical" href={ metadata.Canonical }/>
		<meta property="og:type" content="website"/>
		<meta property="og:site_name" content="Thailand Gift Shop"/>
		<meta property="og:title" content={ metadata.Title }/>
		<meta property="og:description" content={ metadata.Description }/>
		<meta property="og:url" content={ metadata.Canonical }/>
		if metadata.SocialImage != "" {
			<meta property="og:image" content={ metadata.SocialImage }/>
		}
		<meta name="twitter:card" content="summary_large_image"/>
		<meta name="twitter:title" content={ metadata.Title }/>
		<meta name="twitter:description" content={ metadata.Description }/>
		if metadata.SocialImage != "" {
			<meta name="twitter:image" content={ metadata.SocialImage }/>
		}
		<link rel="icon" href="/static/favicon.ico" sizes="any"/>
		<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
		<link rel="apple-touch-icon" href="/static/apple-touch-icon.png" sizes="180x180"/>
		<link rel="manifest" href="/static/site.webmanifest"/>
		<link rel="preload" href={ staticassets.SpaceGrotesk700FontPath } as="font" type="font/woff2" crossorigin/>
		<link rel="preload" href={ staticassets.Inter400FontPath } as="font" type="font/woff2" crossorigin/>
		<link rel="stylesheet" href={ staticassets.AppCSSPath }/>
		if options.Enhance {
			<script src={ staticassets.EnhanceJSPath } defer></script>
		}
		for index, jsonLD := range metadata.JSONLD {
			@templ.JSONScript("structured-data-" + strconv.Itoa(index), jsonLD).WithType("application/ld+json")
		}
	</head>
}

// flagBand renders the Thai flag's five horizontal stripes at true 1:1:2:1:1
// proportions. Pass the height as a literal class (heights divisible by 6px —
// h-1.5, h-3, h-6 — keep stripe rows on integer pixels).
templ flagBand(heightClass string) {
	<div aria-hidden="true" class={ "grid w-full grid-rows-[1fr_1fr_2fr_1fr_1fr] " + heightClass }>
		<span class="bg-flag-red"></span>
		<span class="bg-flag-white"></span>
		<span class="bg-flag-blue"></span>
		<span class="bg-flag-white"></span>
		<span class="bg-flag-red"></span>
	</div>
}

// flagEdge is the vertical sibling of flagBand for seams and edges. Pass the
// width as a literal class (w-3 keeps stripe columns on integer pixels).
templ flagEdge(widthClass string) {
	<div aria-hidden="true" class={ "grid h-full grid-cols-[1fr_1fr_2fr_1fr_1fr] " + widthClass }>
		<span class="bg-flag-red"></span>
		<span class="bg-flag-white"></span>
		<span class="bg-flag-blue"></span>
		<span class="bg-flag-white"></span>
		<span class="bg-flag-red"></span>
	</div>
}

templ breadcrumbNav(items []breadcrumbItem) {
	if len(items) > 0 {
		<nav aria-label="Breadcrumb" class="mb-6 text-xs font-medium text-muted">
			<ol class="flex flex-wrap items-center gap-2.5">
				for index, item := range items {
					<li class="inline-flex items-center gap-2.5">
						if index > 0 {
							<span aria-hidden="true" class="inline-block h-3 w-px rotate-12 bg-flag-blue/30"></span>
						}
						if index == len(items)-1 {
							<a href={ item.Path } aria-current="page" class="text-flag-blue">{ item.Name }</a>
						} else {
							<a href={ item.Path } class="text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">{ item.Name }</a>
						}
					</li>
				}
			</ol>
		</nav>
	}
}

templ siteHeader(mode string, cartLabel string) {
	<header class="sticky top-0 z-30 border-b-2 border-ink bg-paper">
		<a href="#main-content" class="skip-link">Skip to content</a>
		@flagBand("h-1.5")
		<nav aria-label="Main navigation" class="relative mx-auto flex min-h-16 w-full max-w-7xl items-center justify-between gap-3 px-5 sm:px-8">
			<a href="/" aria-label="Thailand Gift Shop home" class="flex min-w-0 items-center gap-3">
				<img class="h-8 w-8 shrink-0 sm:h-9 sm:w-9" src="/static/logo.svg" alt=""/>
				<span class="truncate font-display text-lg font-bold tracking-tight text-ink sm:text-xl">Thailand Gift Shop</span>
			</a>
			if mode == "home" {
				<div class="hidden items-center gap-7 text-sm font-medium text-ink md:flex">
					<a class="decoration-flag-red decoration-2 underline-offset-8 transition hover:text-flag-red hover:underline" href="/products">Products</a>
					<a class="decoration-flag-red decoration-2 underline-offset-8 transition hover:text-flag-red hover:underline" href="#shop-aisles">Aisles</a>
					<a class="decoration-flag-red decoration-2 underline-offset-8 transition hover:text-flag-red hover:underline" href="#categories">Categories</a>
					<a class="decoration-flag-red decoration-2 underline-offset-8 transition hover:text-flag-red hover:underline" href="#story">Story</a>
					<a class="decoration-flag-red decoration-2 underline-offset-8 transition hover:text-flag-red hover:underline" href="/cart">{ cartLabel }</a>
					<a class="decoration-flag-red decoration-2 underline-offset-8 transition hover:text-flag-red hover:underline" href="/account">Account</a>
				</div>
				<div class="flex shrink-0 items-center gap-2">
					<a href="/products" class="inline-flex h-10 items-center justify-center bg-flag-red px-4 text-sm font-bold text-white transition hover:bg-flag-red-deep">Shop gifts</a>
					@mobileNavigation("home", cartLabel)
				</div>
			} else {
				<div class="hidden items-center gap-7 text-sm font-medium text-ink md:flex">
					<a class="decoration-flag-red decoration-2 underline-offset-8 transition hover:text-flag-red hover:underline" href="/products">Products</a>
					<a class="decoration-flag-red decoration-2 underline-offset-8 transition hover:text-flag-red hover:underline" href="/#shop-aisles">Aisles</a>
					<a class="decoration-flag-red decoration-2 underline-offset-8 transition hover:text-flag-red hover:underline" href="/categories">Categories</a>
					<a class="decoration-flag-red decoration-2 underline-offset-8 transition hover:text-flag-red hover:underline" href="/story">Story</a>
					<a class="decoration-flag-red decoration-2 underline-offset-8 transition hover:text-flag-red hover:underline" href="/cart">{ cartLabel }</a>
					<a class="decoration-flag-red decoration-2 underline-offset-8 transition hover:text-flag-red hover:underline" href="/account">Account</a>
				</div>
				<div class="flex shrink-0 items-center gap-2">
					<a href="/products" class="inline-flex h-10 items-center justify-center bg-flag-red px-4 text-sm font-bold text-white transition hover:bg-flag-red-deep">Shop gifts</a>
					@mobileNavigation("page", cartLabel)
				</div>
			}
		</nav>
	</header>
}

templ mobileNavigation(mode string, cartLabel string) {
	<details class="md:hidden">
		<summary class="inline-flex h-10 cursor-pointer list-none items-center justify-center border border-ink bg-paper px-4 text-sm font-bold text-ink transition hover:border-flag-red hover:text-flag-red">Menu</summary>
		<div class="absolute right-5 top-[calc(100%-0.5rem)] z-40 min-w-48 border-2 border-ink bg-paper text-sm font-medium text-ink shadow-lift sm:right-8">
			@flagBand("h-1.5")
			<div class="grid gap-1 p-2">
				if mode == "home" {
					<a class="px-3 py-2 transition hover:bg-flag-white hover:text-flag-red" href="/products">Products</a>
					<a class="px-3 py-2 transition hover:bg-flag-white hover:text-flag-red" href="#shop-aisles">Aisles</a>
					<a class="px-3 py-2 transition hover:bg-flag-white hover:text-flag-red" href="#categories">Categories</a>
					<a class="px-3 py-2 transition hover:bg-flag-white hover:text-flag-red" href="#story">Story</a>
				} else {
					<a class="px-3 py-2 transition hover:bg-flag-white hover:text-flag-red" href="/products">Products</a>
					<a class="px-3 py-2 transition hover:bg-flag-white hover:text-flag-red" href="/#shop-aisles">Aisles</a>
					<a class="px-3 py-2 transition hover:bg-flag-white hover:text-flag-red" href="/categories">Categories</a>
					<a class="px-3 py-2 transition hover:bg-flag-white hover:text-flag-red" href="/story">Story</a>
				}
				<a class="px-3 py-2 transition hover:bg-flag-white hover:text-flag-red" href="/cart">{ cartLabel }</a>
				<a class="px-3 py-2 transition hover:bg-flag-white hover:text-flag-red" href="/account">Account</a>
			</div>
		</div>
	</details>
}

templ siteFooter(cartLabel string) {
	<footer class="bg-ink text-white">
		@flagBand("h-6")
		<div class="px-5 py-10 sm:px-8">
			<div class="mx-auto grid w-full max-w-7xl gap-8 text-sm text-white/72 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
				<div class="max-w-2xl">
					<a href="/" aria-label="Thailand Gift Shop home" class="inline-flex w-fit items-center gap-3 focus-visible:outline-white">
						<img class="h-9 w-9" src="/static/logo.svg" alt=""/>
						<span class="font-display text-lg font-bold tracking-tight text-white">Thailand Gift Shop</span>
					</a>
					<p class="mt-5 text-base leading-7">Browse a Thai gift-shop catalog of snacks, souvenirs, pantry favorites, textiles, decor, wellness, and small keepsakes.</p>
					<p class="mt-3 text-base leading-7">Checkout is handled securely by Stripe. We never see or store card numbers.</p>
					<p class="mt-3 text-base leading-7">Questions? Email <a class="font-semibold underline underline-offset-4 transition hover:text-white/72 focus-visible:outline-white" href="mailto:support@thailandgiftshop.com">support@thailandgiftshop.com</a>.</p>
				</div>
				<div class="grid gap-8 text-sm font-medium text-white sm:grid-cols-2 lg:justify-items-end">
					<nav aria-label="Shop" class="grid content-start gap-3">
						<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-white">Shop</p>
						<a class="transition hover:text-white/72 focus-visible:outline-white" href="/products">Products</a>
						<a class="transition hover:text-white/72 focus-visible:outline-white" href="/categories">Categories</a>
						<a class="transition hover:text-white/72 focus-visible:outline-white" href="/story">Story</a>
						<a class="transition hover:text-white/72 focus-visible:outline-white" href="/cart">{ cartLabel }</a>
						<a class="transition hover:text-white/72 focus-visible:outline-white" href="/account">Account</a>
					</nav>
					<nav aria-label="Help and policies" class="grid content-start gap-3">
						<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-white">Help</p>
						<a class="transition hover:text-white/72 focus-visible:outline-white" href="/shipping">Shipping</a>
						<a class="transition hover:text-white/72 focus-visible:outline-white" href="/returns">Returns and refunds</a>
						<a class="transition hover:text-white/72 focus-visible:outline-white" href="/contact">Contact</a>
						<a class="transition hover:text-white/72 focus-visible:outline-white" href="/privacy">Privacy</a>
						<a class="transition hover:text-white/72 focus-visible:outline-white" href="/terms">Terms</a>
					</nav>
				</div>
			</div>
			<div class="mx-auto mt-10 flex w-full max-w-7xl flex-col gap-2 border-t border-white/10 pt-4 sm:flex-row sm:items-center sm:justify-between">
				<p class="text-xs text-white/50">© Thailand Gift Shop</p>
				<p class="text-xs text-white/50">
					Built with Go, templ &amp; Tailwind on AWS, payments by Stripe. Thanks for visiting —
					<a class="underline underline-offset-4 transition hover:text-white/72 focus-visible:outline-white" href="https://github.com/anhydrous99" target="_blank" rel="noopener noreferrer">find me on GitHub</a>.
				</p>
			</div>
		</div>
	</footer>
}

// confirmDialog renders one reusable confirmation modal for destructive actions
// (clear cart, remove address/card). It stays hidden until enhance.js opens it
// with <dialog>.showModal() in response to a form carrying data-confirm, then
// fills the title/message/accept label from that form's data-* attributes. With
// no JS the dialog never shows and the form posts directly, so it is an additive
// guardrail only. Markup lives here (not in JS) so Tailwind's @source scan keeps
// these utility classes.
templ confirmDialog() {
	<dialog data-confirm-dialog aria-labelledby="confirm-dialog-title" aria-describedby="confirm-dialog-message" class="m-auto w-[calc(100%-2rem)] max-w-md border-2 border-ink bg-paper p-0 text-ink shadow-lift backdrop:bg-ink/60">
		@flagBand("h-1.5")
		<div class="p-6">
			<h2 id="confirm-dialog-title" data-confirm-dialog-title class="font-display text-2xl font-bold tracking-tight text-flag-blue">Are you sure?</h2>
			<p id="confirm-dialog-message" data-confirm-dialog-message class="mt-3 text-sm leading-6 text-muted"></p>
			<div class="mt-6 grid gap-3 sm:grid-cols-2">
				<button type="button" data-confirm-cancel autofocus class="inline-flex h-12 items-center justify-center border-2 border-ink bg-paper px-6 text-sm font-bold text-ink transition hover:border-flag-blue hover:text-flag-blue focus-visible:outline-flag-blue">Cancel</button>
				<button type="button" data-confirm-accept class="inline-flex h-12 items-center justify-center bg-flag-red px-6 text-sm font-bold text-white transition hover:bg-flag-red-deep focus-visible:outline-flag-red">Confirm</button>
			</div>
		</div>
	</dialog>
}
