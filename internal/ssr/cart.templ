package ssr

import "strconv"

templ cartPage(vm cartPageViewModel) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead(vm.Metadata)
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main>
				<section class="px-5 pt-10 pb-12 sm:px-8 lg:pt-14 lg:pb-16">
					<div class="mx-auto w-full max-w-7xl">
						<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Gift bag</p>
						<h1 class="mt-3 font-display text-5xl font-bold leading-none tracking-tight text-flag-blue sm:text-6xl">Cart</h1>
						<p class="mt-5 max-w-3xl text-lg leading-8 text-muted">Review quantities for your Thai gift-shop finds before secure Stripe checkout.</p>
					</div>
				</section>
				@flagBand("h-3")
				<section class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-8 lg:py-16">
					if len(vm.Lines) == 0 {
						<section class="border-2 border-dashed border-flag-blue/25 bg-paper p-10 text-center">
							<div class="mx-auto w-16">
								@flagBand("h-1.5")
							</div>
							<h2 class="mt-5 font-display text-xl font-bold text-flag-blue">Your cart is empty.</h2>
							<p class="mt-2 text-sm leading-6 text-muted">Browse the latest Thai snacks, souvenirs, pantry favorites, and small keepsakes to start a gift bag.</p>
							<a href="/products" class="mt-6 inline-flex h-12 items-center justify-center bg-flag-red px-6 text-sm font-bold text-white transition hover:bg-flag-red-deep">Continue shopping</a>
						</section>
					} else {
						<div class="grid gap-8 lg:grid-cols-[1fr_22rem] lg:items-start">
							<section aria-label="Cart line items" class="grid gap-4">
								for _, line := range vm.Lines {
									<article data-testid="cart-line-item" class="grid gap-4 border border-flag-blue/15 bg-paper p-4 sm:grid-cols-[9rem_1fr] sm:p-5">
										<img class="aspect-[4/3] w-full bg-flag-white object-cover" src={ line.Product.DisplayImageURL(vm.ProductImagePlaceholderURL) } alt={ line.Product.Name } loading="lazy"/>
										<div class="grid gap-4 sm:grid-cols-[1fr_auto] sm:items-start">
											<div>
												<a href={ "/products/" + line.Product.Slug } class="font-display text-xl font-medium leading-7 text-flag-blue transition hover:text-flag-red">{ line.Product.Name }</a>
												if line.VariantLabel != "" {
													<p class="mt-2 inline-flex bg-flag-white px-2.5 py-1 text-xs font-semibold text-flag-blue">Size { line.VariantLabel }</p>
												}
												if !line.Available {
													<p class="mt-3 border-l-4 border-flag-red bg-flag-red/10 px-4 py-3 text-sm font-semibold text-flag-red">{ line.UnavailableMessage }</p>
												}
												<p class="mt-2 text-sm leading-6 text-muted">Unit price <span class="font-bold tabular-nums text-flag-red">{ formatPrice(line.Product.PriceCents) }</span></p>
												<p class="mt-1 text-sm leading-6 text-muted">Line total <span class="font-bold tabular-nums text-flag-blue">{ formatPrice(lineTotalCents(line)) }</span></p>
											</div>
											<div class="grid gap-3 sm:min-w-48">
												if line.Available {
													<form method="post" action={ "/cart/items/" + line.Product.Slug + "/quantity" } class="flex items-end gap-2">
														<input type="hidden" name="variant_id" value={ line.VariantID }/>
														<label class="grid gap-1 text-xs font-medium text-muted">
															Quantity
															<input name="quantity" type="number" min="1" max={ strconv.Itoa(cartLineQuantityLimit(line)) } value={ strconv.Itoa(line.Quantity) } class="h-11 w-24 border border-flag-blue/25 bg-flag-white px-4 text-sm font-medium text-ink transition focus:border-flag-blue focus:bg-paper"/>
														</label>
														<button type="submit" class="inline-flex h-11 items-center justify-center bg-flag-blue px-4 text-sm font-bold text-white transition hover:bg-ink">Update</button>
													</form>
												} else {
													<div class="flex items-end gap-2 opacity-70">
														<label class="grid gap-1 text-xs font-medium text-muted">
															Quantity
															<input name="quantity" type="number" value={ strconv.Itoa(line.Quantity) } class="h-11 w-24 border border-flag-blue/25 bg-flag-white px-4 text-sm font-medium text-ink" disabled/>
														</label>
														<button type="button" class="inline-flex h-11 cursor-not-allowed items-center justify-center bg-muted/40 px-4 text-sm font-bold text-white/80" disabled>Update</button>
													</div>
												}
												<form method="post" action={ "/cart/items/" + line.Product.Slug + "/remove" }>
													<input type="hidden" name="variant_id" value={ line.VariantID }/>
													<button type="submit" class="text-sm font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Remove</button>
												</form>
											</div>
										</div>
									</article>
								}
							</section>
							<aside class="border border-flag-blue bg-flag-blue text-white">
								@flagBand("h-1.5")
								<div class="p-6">
									<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-white">Order summary</p>
									<div class="mt-5 flex items-center justify-between border-t border-white/15 pt-5">
										<p class="text-base font-bold text-white">Subtotal</p>
										<p class="font-display text-3xl font-bold tabular-nums text-white">{ formatPrice(subtotalCents(vm.Lines)) }</p>
									</div>
									<p class="mt-3 text-sm leading-6 text-white/70">Payment is processed by Stripe at checkout. Shipping is free while we launch; tax is not collected yet.</p>
									<div class="mt-6 grid gap-3">
										if hasUnavailableCartLines(vm.Lines) {
											<p class="border-l-4 border-flag-red bg-flag-red/20 px-4 py-3 text-sm font-semibold leading-6 text-white">Remove unavailable sizes before checkout.</p>
										} else {
											<a href="/checkout" class="inline-flex h-12 items-center justify-center bg-flag-red px-6 text-sm font-bold text-white transition hover:bg-flag-red-deep focus-visible:outline-white">Check out</a>
										}
										<a href="/products" class="inline-flex h-12 items-center justify-center border-2 border-white/60 px-6 text-sm font-bold text-white transition hover:bg-white hover:text-flag-blue focus-visible:outline-white">Continue shopping</a>
										<form method="post" action="/cart/clear">
											<button type="submit" class="inline-flex h-12 w-full items-center justify-center border border-flag-red/60 bg-flag-red/20 px-6 text-sm font-bold text-white transition hover:bg-flag-red focus-visible:outline-white">Clear cart</button>
										</form>
									</div>
								</div>
							</aside>
						</div>
					}
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}
