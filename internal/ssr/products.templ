package ssr

templ productListingPage(vm productListingPageViewModel) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead(vm.Metadata)
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main id="main-content" tabindex="-1">
				<section class="px-5 pt-10 pb-12 sm:px-8 lg:pt-14 lg:pb-16">
					<div class="mx-auto w-full max-w-7xl">
						@breadcrumbNav(vm.Breadcrumbs)
						<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Shop all</p>
						<h1 class="mt-3 font-display text-5xl font-bold leading-none tracking-tight text-flag-blue sm:text-6xl">Products</h1>
						<p class="mt-5 max-w-3xl text-lg leading-8 text-muted">Browse Thai snacks, souvenirs, textiles, pantry items, decor, wellness, and small keepsakes.</p>
					</div>
				</section>
				@flagBand("h-3")
				<section class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-8 lg:py-16">
					if len(vm.Products) == 0 {
						<section class="border-2 border-dashed border-flag-blue/25 bg-paper p-10 text-center">
							<div class="mx-auto w-16">
								@flagBand("h-1.5")
							</div>
							<h2 class="mt-5 font-display text-xl font-bold text-flag-blue">No products are available yet.</h2>
							<p class="mt-2 text-sm leading-6 text-muted">Check back soon for Thai gift-shop finds.</p>
						</section>
					} else {
						<section aria-label="Products" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
							for index, product := range vm.Products {
								@productCard(product, vm.ProductImagePlaceholderURL, index < 4)
							}
						</section>
					}
				</section>
				if len(vm.Categories) > 0 {
					<section class="bg-flag-white px-5 py-14 sm:px-8 lg:py-20">
						<div class="mx-auto w-full max-w-7xl">
							<div class="mb-8 max-w-3xl">
								<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Browse categories</p>
								<h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-flag-blue sm:text-4xl">Browse categories</h2>
								<span aria-hidden="true" class="mt-4 block h-1 w-16 bg-flag-red"></span>
							</div>
							<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
								for _, category := range vm.Categories {
									@categoryCard(category)
								}
							</div>
						</div>
					</section>
				}
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}
