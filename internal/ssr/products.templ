package ssr

templ productListingPage(vm productListingPageViewModel) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead("Products | Thailand Gift Shop")
		<body class="min-h-screen bg-[#F8F4EE] text-[#17172A] antialiased">
			@siteHeader("page")
			<main>
				<section class="border-b border-[#2D2A4A]/10 bg-white px-5 py-14 sm:px-8 lg:py-18">
					<div class="mx-auto w-full max-w-7xl">
						<p class="text-sm font-black uppercase tracking-wide text-[#A51931]">Shop all</p>
						<h1 class="mt-3 text-5xl font-black leading-none text-[#2D2A4A] sm:text-6xl">Products</h1>
						<p class="mt-5 max-w-3xl text-lg leading-8 text-[#4C4A62]">Browse Thai snacks, souvenirs, textiles, pantry items, decor, wellness, and small keepsakes.</p>
					</div>
				</section>
				<section class="mx-auto w-full max-w-7xl px-5 py-14 sm:px-8 lg:py-20">
					if len(vm.Products) == 0 {
						<section class="rounded-lg border border-dashed border-[#2D2A4A]/25 bg-white p-8 text-center shadow-sm">
							<h2 class="text-xl font-bold text-[#2D2A4A]">No products are available yet.</h2>
							<p class="mt-2 text-sm leading-6 text-[#4C4A62]">Check back soon for Thai gift-shop finds.</p>
						</section>
					} else {
						<section aria-label="Products" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
							for _, product := range vm.Products {
								@productCard(product, vm.ProductImagePlaceholderURL)
							}
						</section>
					}
				</section>
				if len(vm.Categories) > 0 {
					<section class="border-t border-[#2D2A4A]/10 bg-white px-5 py-14 sm:px-8 lg:py-20">
						<div class="mx-auto w-full max-w-7xl">
							<div class="mb-8 max-w-3xl">
								<p class="text-sm font-black uppercase tracking-wide text-[#A51931]">Browse categories</p>
								<h2 class="mt-2 text-3xl font-black text-[#2D2A4A] sm:text-4xl">Browse categories</h2>
							</div>
							<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
								for _, category := range vm.Categories {
									@categoryCard(category)
								}
							</div>
						</div>
					</section>
				}
			</main>
			@siteFooter()
		</body>
	</html>
}
