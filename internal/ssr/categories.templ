package ssr

templ categoryIndexPage(vm categoryIndexPageViewModel) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead(vm.Metadata)
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main id="main-content" tabindex="-1">
				<section class="px-5 pt-10 pb-12 sm:px-8 lg:pt-14 lg:pb-16">
					<div class="mx-auto w-full max-w-7xl">
						@breadcrumbNav(vm.Breadcrumbs)
						<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Shop aisles</p>
						<h1 class="mt-3 font-display text-5xl font-bold leading-none tracking-tight text-flag-blue sm:text-6xl">Categories</h1>
						<p class="mt-5 max-w-3xl text-lg leading-8 text-muted">Shop Thai gift-shop finds by aisle.</p>
					</div>
				</section>
				@flagBand("h-3")
				<section class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-8 lg:py-16">
					if len(vm.Categories) == 0 {
						<section class="border-2 border-dashed border-flag-blue/25 bg-paper p-10 text-center">
							<div class="mx-auto w-16">
								@flagBand("h-1.5")
							</div>
							<h2 class="mt-5 font-display text-xl font-bold text-flag-blue">No categories are available yet.</h2>
							<p class="mt-2 text-sm leading-6 text-muted">Check back soon for more Thai gift-shop aisles.</p>
						</section>
					} else {
						<section aria-label="Categories" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
							for _, category := range vm.Categories {
								@categoryCard(category)
							}
						</section>
					}
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}
