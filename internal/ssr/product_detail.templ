package ssr

templ productDetailPage(vm productDetailPageViewModel) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHeadWithOptions(vm.Metadata, siteHeadOptions{Enhance: true})
		<body class="min-h-screen bg-paper text-ink antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main id="main-content" tabindex="-1">
				<section class="mx-auto grid w-full max-w-7xl gap-8 px-5 py-12 sm:px-8 lg:grid-cols-[1fr_0.9fr] lg:py-16">
					<div class="relative self-start border border-flag-blue/15 bg-paper">
						@productImagePicture(vm.Product.DisplayImageURL(vm.ProductImagePlaceholderURL), vm.Product.Name, "aspect-[4/3] w-full bg-flag-white object-cover", "(min-width: 1024px) 50vw, 100vw", "", "high")
						<div class="absolute inset-y-0 left-0">
							@flagEdge("w-3")
						</div>
					</div>
					<div class="self-center">
						@breadcrumbNav(vm.Breadcrumbs)
						<a href="/products" class="text-sm font-bold text-flag-red transition hover:text-flag-red-deep hover:underline hover:underline-offset-4">Back to products</a>
						<h1 class="mt-5 font-display text-5xl font-bold leading-none tracking-tight text-flag-blue sm:text-6xl">{ vm.Product.Name }</h1>
						<p class="mt-6 font-display text-2xl font-bold tabular-nums text-flag-red">{ formatPrice(vm.Product.PriceCents) }</p>
						<p class="mt-6 text-lg leading-8 text-muted">{ vm.Product.Description }</p>
						if len(vm.Categories) > 0 {
							<div class="mt-6 flex flex-wrap gap-2" aria-label="Product categories">
								for _, category := range vm.Categories {
									<a href={ "/categories/" + category.Slug } class="inline-flex border border-flag-blue/20 bg-paper px-3 py-1.5 text-xs font-semibold text-flag-blue transition hover:border-flag-red hover:text-flag-red">{ category.Name }</a>
								}
							</div>
						}
						if vm.Product.OutOfStock() {
							<div class="mt-6 border-l-4 border-flag-red bg-flag-red/10 p-5">
								<p class="inline-flex items-center gap-1.5 border border-flag-red/25 bg-paper px-2.5 py-1 text-xs font-semibold text-flag-red"><span aria-hidden="true" class="h-1.5 w-1.5 bg-flag-red"></span>Out of stock</p>
								<p class="mt-4 text-sm leading-6 text-muted">This item cannot be added to cart right now.</p>
							</div>
						} else {
							<div class="mt-6 border border-flag-blue/15 bg-paper p-5">
								<p class="inline-flex items-center gap-1.5 border border-flag-blue/20 bg-flag-white px-2.5 py-1 text-xs font-semibold text-flag-blue"><span aria-hidden="true" class="h-1.5 w-1.5 bg-flag-blue"></span>In stock</p>
								<form method="POST" action="/cart/items" class="mt-5 grid gap-4 sm:grid-cols-[1fr_auto_auto] sm:items-end">
									<input type="hidden" name="slug" value={ vm.Product.Slug }/>
									if vm.Product.UsesVariants() {
										<label class="block text-xs font-medium text-muted">
											<span class="block">Size</span>
											<select data-testid="variant-select" class="field-input mt-2 h-12 w-full text-base" name="variant_id" required>
												<option value="">Select a size</option>
												for _, variant := range vm.Product.ActiveVariants() {
													if variant.StockQuantity > 0 {
														<option value={ variant.ID } data-stock={ variant.StockQuantity }>{ variant.Label }</option>
													} else {
														<option value={ variant.ID } disabled>{ variant.Label } - out of stock</option>
													}
												}
											</select>
										</label>
									}
									<label class="block text-xs font-medium text-muted">
										<span class="block">Quantity</span>
										<input class="field-input mt-2 h-12 w-28 text-base" type="number" name="quantity" value="1" min="1" max={ cartQuantityLimit(vm.Product) }/>
									</label>
									<button type="submit" class="inline-flex h-12 items-center justify-center bg-flag-red px-6 text-sm font-bold text-white transition hover:bg-flag-red-deep">Add to cart</button>
								</form>
								if vm.Product.UsesVariants() {
									<p data-variant-stock-hint aria-live="polite" hidden class="mt-4 text-xs font-semibold text-flag-blue"></p>
								}
								<p class="mt-5 text-sm leading-6 text-muted">Checkout is handled securely by Stripe. Shipping is free while we launch; tax is not collected yet.</p>
							</div>
						}
					</div>
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}
