package ssr

templ productDetailPage(vm productDetailPageViewModel) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@siteHead(vm.Metadata)
		<body class="min-h-screen bg-[#F8F4EE] text-[#17172A] antialiased">
			@siteHeader("page", vm.HeaderCartLabel)
			<main>
				<section class="mx-auto grid w-full max-w-7xl gap-8 px-5 py-14 sm:px-8 lg:grid-cols-[1fr_0.9fr] lg:py-20">
					<div class="overflow-hidden rounded-lg border border-[#2D2A4A]/15 bg-white shadow-sm">
						<img class="aspect-[4/3] w-full bg-[#F4F5F8] object-cover" src={ vm.Product.DisplayImageURL(vm.ProductImagePlaceholderURL) } alt={ vm.Product.Name }/>
					</div>
					<div class="self-center">
						@breadcrumbNav(vm.Breadcrumbs)
						<a href="/products" class="text-sm font-black text-[#A51931] transition hover:text-[#831426]">Back to products</a>
						<h1 class="mt-5 text-5xl font-black leading-none text-[#2D2A4A] sm:text-6xl">{ vm.Product.Name }</h1>
						<p class="mt-6 inline-flex rounded-full bg-white px-4 py-2 text-xl font-black text-[#A51931] shadow-sm">{ formatPrice(vm.Product.PriceCents) }</p>
						<p class="mt-6 text-lg leading-8 text-[#4C4A62]">{ vm.Product.Description }</p>
						if len(vm.Categories) > 0 {
							<div class="mt-6 flex flex-wrap gap-2" aria-label="Product categories">
								for _, category := range vm.Categories {
									<a href={ "/categories/" + category.Slug } class="inline-flex rounded-full border border-[#2D2A4A]/15 bg-white px-3 py-1 text-xs font-black text-[#2D2A4A] shadow-sm transition hover:border-[#A51931]/30 hover:text-[#A51931]">{ category.Name }</a>
								}
							</div>
						}
						if vm.Product.OutOfStock() {
							<div class="mt-6 rounded-lg border border-[#A51931]/20 bg-[#A51931]/10 p-5">
								<p class="inline-flex rounded-full bg-white px-4 py-2 text-sm font-black text-[#A51931] shadow-sm">Out of stock</p>
								<p class="mt-4 text-sm font-bold leading-6 text-[#4C4A62]">This item cannot be added to cart right now.</p>
							</div>
						} else {
							<div class="mt-6 rounded-lg border border-[#2D2A4A]/15 bg-white p-5 shadow-sm">
								<p class="inline-flex rounded-full bg-[#2D2A4A]/10 px-4 py-2 text-sm font-black text-[#2D2A4A]">In stock</p>
								<form method="POST" action="/cart/items" class="mt-5 grid gap-4 sm:grid-cols-[1fr_auto_auto] sm:items-end">
									<input type="hidden" name="slug" value={ vm.Product.Slug }/>
									if vm.Product.UsesVariants() {
										<label class="block text-sm font-black text-[#2D2A4A]">
											<span class="block">Size</span>
											<select data-testid="variant-select" class="mt-2 h-12 w-full rounded-lg border border-[#2D2A4A]/20 bg-[#F8F4EE] px-4 text-base font-black text-[#17172A] shadow-sm focus:border-[#A51931] focus:outline-none focus:ring-2 focus:ring-[#A51931]/20" name="variant_id" required>
												<option value="">Select a size</option>
												for _, variant := range vm.Product.ActiveVariants() {
													if variant.StockQuantity > 0 {
														<option value={ variant.ID }>{ variant.Label }</option>
													} else {
														<option value={ variant.ID } disabled>{ variant.Label } - out of stock</option>
													}
												}
											</select>
										</label>
									}
									<label class="block text-sm font-black text-[#2D2A4A]">
										<span class="block">Quantity</span>
										<input class="mt-2 h-12 w-28 rounded-lg border border-[#2D2A4A]/20 bg-[#F8F4EE] px-4 text-base font-black text-[#17172A] shadow-sm focus:border-[#A51931] focus:outline-none focus:ring-2 focus:ring-[#A51931]/20" type="number" name="quantity" value="1" min="1" max={ cartQuantityLimit(vm.Product) }/>
									</label>
									<button type="submit" class="inline-flex h-12 items-center justify-center rounded-full bg-[#A51931] px-6 text-sm font-black text-white shadow-sm transition hover:bg-[#831426] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2D2A4A]">Add to cart</button>
								</form>
								<p class="mt-5 text-sm leading-6 text-[#4C4A62]">Adding this item starts a cart review. No payment is collected yet, shipping and tax are not included, and Stripe payment processing will be added later.</p>
							</div>
						}
					</div>
				</section>
			</main>
			@siteFooter(vm.HeaderCartLabel)
		</body>
	</html>
}
