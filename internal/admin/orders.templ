package admin

import "strconv"

templ adminOrderListPage(vm adminOrderListViewModel) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@adminHead("Orders | Thailand Gift Shop Admin")
		<body class="min-h-screen bg-paper text-ink antialiased">
			<div data-testid="admin-shell" class="min-h-screen">
				@adminHeader(vm.CSRFValue, "orders")
				<main id="admin-main" class="mx-auto w-full max-w-7xl px-5 py-10 sm:px-8 lg:py-14">
					<section class="border border-flag-blue bg-flag-blue text-white">
						@adminFlagBand("h-1.5")
						<div class="grid gap-6 p-6 sm:p-8">
							<div>
								<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-white">Order desk</p>
								<h1 class="mt-3 font-display text-5xl font-bold leading-none tracking-tight text-white sm:text-6xl">Orders</h1>
								<p class="mt-5 max-w-3xl text-lg leading-8 text-white/80">Newest orders first. Add tracking, advance paid orders through shipping and delivery, and cancel with automatic stock release.</p>
							</div>
						</div>
					</section>
					<section class="mt-6 border border-flag-blue/15 bg-paper">
						if len(vm.Orders) == 0 {
							<div data-testid="admin-orders-empty" role="status" class="p-8 text-center"><h2 class="font-display text-xl font-bold text-flag-blue">No orders yet.</h2><p class="mt-2 text-sm leading-6 text-muted">Orders appear here the moment a shopper starts checkout.</p></div>
						} else {
							<div class="divide-y divide-flag-blue/10">
								for _, row := range vm.Orders {
									<article data-testid="admin-order-row" class="grid gap-4 p-5 md:grid-cols-[1fr_auto_auto] md:items-center">
										<div>
											<a href={ "/admin/orders/" + row.Order.ID } class="break-all font-display text-xl font-medium text-flag-blue transition hover:text-flag-red">Order { row.Order.ID }</a>
											if row.Order.CustomerID == "" {
												<p class="mt-1 text-sm leading-6 text-muted">{ row.Order.Email } · { formatAdminOrderTime(row.Order.CreatedAt) } · { strconv.Itoa(adminOrderItemCount(row.Order)) } items · Guest</p>
											} else {
												<p class="mt-1 text-sm leading-6 text-muted">{ row.Order.Email } · { formatAdminOrderTime(row.Order.CreatedAt) } · { strconv.Itoa(adminOrderItemCount(row.Order)) } items</p>
											}
											<p class="mt-2 flex flex-wrap gap-2">
												<span data-testid="admin-order-status" class={ adminOrderStatusChipClass(row.Order.Status) }>{ adminOrderStatusLabel(row.Order.Status) }</span>
												if row.Overdue {
													<span data-testid="admin-order-overdue" class="inline-flex bg-flag-red px-2.5 py-1 text-xs font-bold uppercase tracking-eyebrow text-white">Overdue pending</span>
												}
											</p>
										</div>
										<p class="font-display text-xl font-bold text-flag-blue">{ formatAdminPrice(row.Order.TotalCents) }</p>
										<a href={ "/admin/orders/" + row.Order.ID } class="inline-flex h-11 items-center justify-center bg-flag-blue px-5 text-sm font-bold text-white transition hover:bg-ink">Review</a>
									</article>
								}
							</div>
							if vm.NextCursor != "" {
								<div class="border-t border-flag-blue/10 p-5">
									<a data-testid="admin-orders-next-page" href={ "/admin/orders?after=" + vm.NextCursor } class="inline-flex h-11 items-center justify-center bg-flag-blue px-5 text-sm font-bold text-white transition hover:bg-ink">Older orders</a>
								</div>
							}
						}
					</section>
				</main>
			</div>
		</body>
	</html>
}
