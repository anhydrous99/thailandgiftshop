package admin

templ adminAnalyticsPage(vm analyticsViewModel) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@adminHead("Analytics | Thailand Gift Shop Admin")
		<body class="min-h-screen bg-paper text-ink antialiased">
			<div data-testid="admin-shell" class="min-h-screen">
				@adminHeader(vm.CSRFValue, "analytics")
				<main id="admin-main" class="mx-auto w-full max-w-7xl px-5 py-10 sm:px-8 lg:py-14">
					<section class="border border-flag-blue bg-flag-blue text-white">
						@adminFlagBand("h-1.5")
						<div class="grid gap-6 p-6 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-end">
							<div>
								<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-white">Business analytics</p>
								<h1 class="mt-3 font-display text-5xl font-bold leading-none tracking-tight text-white sm:text-6xl">Analytics</h1>
								<p data-testid="admin-analytics-window" class="mt-5 max-w-3xl text-lg leading-8 text-white/80">Revenue, fulfillment, and best sellers for { vm.WindowLabel }. Figures attribute revenue to the order date and recognize it once an order is paid.</p>
							</div>
							<nav data-testid="admin-analytics-range" aria-label="Reporting period" class="flex flex-wrap gap-2 text-sm font-medium">
								for _, option := range vm.RangeOptions {
									if option.Active {
										<a data-testid={ "admin-analytics-range-" + option.Key } aria-current="page" href={ templ.SafeURL(option.Href) } class="inline-flex h-10 items-center justify-center bg-white px-4 font-bold text-flag-blue transition">{ option.Label }</a>
									} else {
										<a data-testid={ "admin-analytics-range-" + option.Key } href={ templ.SafeURL(option.Href) } class="inline-flex h-10 items-center justify-center border border-white/40 px-4 text-white transition hover:bg-white/10">{ option.Label }</a>
									}
								}
							</nav>
						</div>
					</section>
					if vm.Truncated {
						<p data-testid="admin-analytics-truncated" role="status" class="mt-6 border-l-4 border-gold bg-flag-white px-5 py-4 text-sm font-semibold text-flag-blue">This window holds more orders than the per-view limit. Figures cover the most recent orders only; narrow the period for complete totals.</p>
					}
					if !vm.HasOrders {
						<div data-testid="admin-analytics-empty" role="status" class="mt-6 border border-flag-blue/15 bg-paper p-8 text-center">
							<h2 class="font-display text-xl font-bold text-flag-blue">No orders in this period.</h2>
							<p class="mt-2 text-sm leading-6 text-muted">Pick a longer reporting period above, or check back once shoppers start checking out.</p>
						</div>
					} else {
						<section aria-label="Revenue summary" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
							<article class="border border-flag-blue/15 bg-paper lg:col-span-2">
								<span aria-hidden="true" class="block h-1.5 bg-flag-red"></span>
								<div class="p-5">
									<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Gross revenue</p>
									<p data-testid="admin-analytics-gross-revenue" class="mt-3 font-display text-4xl font-bold leading-none text-flag-blue">{ vm.GrossRevenue }</p>
									<p class="mt-2 text-sm leading-6 text-muted">Paid orders placed in this period.</p>
								</div>
							</article>
							<article class="border border-flag-blue/15 bg-paper lg:col-span-2">
								<span aria-hidden="true" class="block h-1.5 bg-flag-blue"></span>
								<div class="p-5">
									<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Net revenue</p>
									<p data-testid="admin-analytics-net-revenue" class="mt-3 font-display text-4xl font-bold leading-none text-flag-blue">{ vm.NetRevenue }</p>
									<p class="mt-2 text-sm leading-6 text-muted">Gross less refunded order totals.</p>
								</div>
							</article>
							<article class="border border-flag-blue/15 bg-paper lg:col-span-2">
								<span aria-hidden="true" class="block h-1.5 bg-gold"></span>
								<div class="p-5">
									<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Average order value</p>
									<p data-testid="admin-analytics-aov" class="mt-3 font-display text-4xl font-bold leading-none text-flag-blue">{ vm.AOV }</p>
									<p class="mt-2 text-sm leading-6 text-muted">Gross revenue per paid order.</p>
								</div>
							</article>
							<article class="border border-flag-blue/15 bg-paper p-5 lg:col-span-2">
								<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Orders</p>
								<p data-testid="admin-analytics-orders" class="mt-3 font-display text-3xl font-bold leading-none text-flag-blue">{ vm.OrdersCount }</p>
								<p class="mt-2 text-sm leading-6 text-muted">All orders placed in the period.</p>
							</article>
							<article class="border border-flag-blue/15 bg-paper p-5 lg:col-span-2">
								<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Paid orders</p>
								<p data-testid="admin-analytics-paid-orders" class="mt-3 font-display text-3xl font-bold leading-none text-flag-blue">{ vm.PaidOrders }</p>
								<p class="mt-2 text-sm leading-6 text-muted">Orders that reached payment.</p>
							</article>
							<article class="border border-flag-blue/15 bg-paper p-5 lg:col-span-2">
								<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Refunded</p>
									<p data-testid="admin-analytics-refunded" class="mt-3 font-display text-3xl font-bold leading-none text-flag-blue">{ vm.Refunded }</p>
									<p class="mt-2 text-sm leading-6 text-muted">Refunded totals for orders placed in this period.</p>
							</article>
						</section>
						<section aria-label="Revenue and orders over time" class="mt-8 border border-flag-blue/15 bg-paper">
							<div class="flex flex-wrap items-center justify-between gap-3 border-b border-flag-blue/10 p-5">
								<h2 class="font-display text-xl font-bold text-flag-blue">Revenue &amp; orders over time</h2>
								<div class="flex flex-wrap items-center gap-4 text-xs font-semibold uppercase tracking-eyebrow text-muted">
									<span class="inline-flex items-center gap-2"><span aria-hidden="true" class="inline-block h-3 w-3 bg-flag-blue"></span>Revenue</span>
									<span class="inline-flex items-center gap-2"><span aria-hidden="true" class="inline-block h-0.5 w-4 bg-flag-red"></span>Orders</span>
									<span>Peak { vm.Chart.MaxRevenueLabel }</span>
								</div>
							</div>
							<div class="p-5">
								if vm.Chart.HasData {
									<svg viewBox={ "0 0 " + fmtCoord(vm.Chart.Width) + " " + fmtCoord(vm.Chart.Height) } role="img" aria-label="Revenue bars with an order-count overlay for each period" preserveAspectRatio="none" class="h-auto w-full">
										<line x1="0" y1={ fmtCoord(vm.Chart.BaselineY) } x2={ fmtCoord(vm.Chart.Width) } y2={ fmtCoord(vm.Chart.BaselineY) } class="stroke-flag-blue/25" stroke-width="1"></line>
										for _, bar := range vm.Chart.Bars {
											<rect x={ fmtCoord(bar.X) } y={ fmtCoord(bar.Y) } width={ fmtCoord(bar.Width) } height={ fmtCoord(bar.Height) } class="fill-flag-blue">
												<title>{ bar.Aria }</title>
											</rect>
											if bar.ShowLabel {
												<text x={ fmtCoord(bar.LabelX) } y={ fmtCoord(vm.Chart.Height - 8) } text-anchor="middle" class="fill-muted text-[14px]">{ bar.Label }</text>
											}
										}
										if vm.Chart.LinePoints != "" {
											<polyline points={ vm.Chart.LinePoints } class="fill-none stroke-flag-red" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"></polyline>
										}
									</svg>
								} else {
									<p class="py-10 text-center text-sm text-muted">No paid revenue recorded in this period yet.</p>
								}
							</div>
						</section>
						<div class="mt-8 grid gap-6 lg:grid-cols-2">
							<section aria-label="Orders by status" class="border border-flag-blue/15 bg-paper">
								<div class="border-b border-flag-blue/10 p-5">
									<h2 class="font-display text-xl font-bold text-flag-blue">Orders by status</h2>
								</div>
								<div class="divide-y divide-flag-blue/10">
									for _, status := range vm.StatusRows {
										<div data-testid="admin-analytics-status-row" class="flex items-center justify-between gap-4 p-4">
											<span class={ status.ChipClass }>{ status.Label }</span>
											<span class="font-display text-lg font-bold text-flag-blue">{ status.Count } <span class="text-sm font-medium text-muted">({ status.Percent })</span></span>
										</div>
									}
								</div>
							</section>
							<section aria-label="Fulfillment backlog" class="border border-flag-blue/15 bg-paper">
								<div class="border-b border-flag-blue/10 p-5">
									<h2 class="font-display text-xl font-bold text-flag-blue">Fulfillment</h2>
									<p class="mt-1 text-sm leading-6 text-muted">Open counts and average times for orders placed in this period.</p>
								</div>
								<div class="grid grid-cols-2 gap-px bg-flag-blue/10">
									<div class="bg-paper p-5">
										<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Awaiting shipment</p>
										<p data-testid="admin-analytics-awaiting" class="mt-2 font-display text-3xl font-bold leading-none text-flag-blue">{ vm.AwaitingFulfillment }</p>
									</div>
									<div class="bg-paper p-5">
										<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">In transit</p>
										<p data-testid="admin-analytics-in-transit" class="mt-2 font-display text-3xl font-bold leading-none text-flag-blue">{ vm.InTransit }</p>
									</div>
									<div class="bg-paper p-5">
										<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Oldest awaiting</p>
										<p data-testid="admin-analytics-oldest-awaiting" class="mt-2 font-display text-2xl font-bold leading-none text-flag-blue">{ vm.OldestAwaiting }</p>
									</div>
									<div class="bg-paper p-5">
										<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Avg paid → shipped</p>
										<p data-testid="admin-analytics-paid-to-shipped" class="mt-2 font-display text-2xl font-bold leading-none text-flag-blue">{ vm.PaidToShipped }</p>
									</div>
									<div class="bg-paper p-5">
										<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Avg shipped → delivered</p>
										<p data-testid="admin-analytics-shipped-to-delivered" class="mt-2 font-display text-2xl font-bold leading-none text-flag-blue">{ vm.ShippedToDelivered }</p>
									</div>
								</div>
							</section>
						</div>
						<section aria-label="Top products" class="mt-8 border border-flag-blue/15 bg-paper">
							<div class="border-b border-flag-blue/10 p-5">
								<h2 class="font-display text-xl font-bold text-flag-blue">Best sellers</h2>
								<p class="mt-1 text-sm leading-6 text-muted">Units and revenue from paid orders in this period.</p>
							</div>
							if len(vm.TopProducts) == 0 {
								<p data-testid="admin-analytics-products-empty" role="status" class="p-8 text-center text-sm text-muted">No paid product sales in this period.</p>
							} else {
								<div class="divide-y divide-flag-blue/10">
									for _, product := range vm.TopProducts {
										<article data-testid="admin-analytics-product-row" class="grid items-center gap-4 p-5 md:grid-cols-[auto_1fr_auto_auto]">
											<span class="inline-flex h-8 w-8 items-center justify-center bg-flag-blue text-sm font-bold text-white">{ product.Rank }</span>
											<div class="min-w-0">
												<p class="truncate font-display text-lg font-medium text-flag-blue">{ product.Name }</p>
												if product.Variant != "" {
													<p class="mt-1 text-sm text-muted">{ product.Variant }</p>
												}
											</div>
											<p class="text-sm font-semibold text-muted">{ product.Units } sold</p>
											<p class="font-display text-lg font-bold text-flag-blue">{ product.Revenue }</p>
										</article>
									}
								</div>
							}
						</section>
					}
				</main>
			</div>
		</body>
	</html>
}
