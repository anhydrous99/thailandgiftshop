package admin

import "strconv"

templ adminHead(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="robots" content="noindex,nofollow"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ title }</title>
		<link rel="icon" href="/static/favicon.ico" sizes="any"/>
		<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
		<link rel="apple-touch-icon" href="/static/apple-touch-icon.png" sizes="180x180"/>
		<link rel="manifest" href="/static/site.webmanifest"/>
		<link rel="preload" href="/static/fonts/space-grotesk-latin-700.woff2" as="font" type="font/woff2" crossorigin/>
		<link rel="preload" href="/static/fonts/inter-latin-400.woff2" as="font" type="font/woff2" crossorigin/>
		<link rel="stylesheet" href="/static/assets/app.css"/>
	</head>
}

// adminFlagBand mirrors the public site's flag band: the Thai flag's five
// horizontal stripes at 1:1:2:1:1. Pass the height as a literal class.
templ adminFlagBand(heightClass string) {
	<div aria-hidden="true" class={ "grid w-full grid-rows-[1fr_1fr_2fr_1fr_1fr] " + heightClass }>
		<span class="bg-flag-red"></span>
		<span class="bg-flag-white"></span>
		<span class="bg-flag-blue"></span>
		<span class="bg-flag-white"></span>
		<span class="bg-flag-red"></span>
	</div>
}

templ adminDashboardPage(vm adminDashboardViewModel) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@adminHead("Admin dashboard | Thailand Gift Shop")
		<body class="min-h-screen bg-paper text-ink antialiased">
			<div data-testid="admin-shell" class="min-h-screen">
				<header class="sticky top-0 z-30 border-b-2 border-ink bg-paper">
					@adminFlagBand("h-1.5")
					<div class="mx-auto flex min-h-16 w-full max-w-7xl flex-col gap-4 px-5 pb-4 pt-7 sm:px-8 md:flex-row md:items-center md:justify-between">
						<a href="/admin" aria-label="Thailand Gift Shop admin dashboard" class="flex min-w-0 items-center gap-3">
							<img class="h-8 w-8 shrink-0 sm:h-9 sm:w-9" src="/static/logo.svg" alt=""/>
							<span class="truncate font-display text-lg font-bold tracking-tight text-ink">Thailand Gift Shop</span>
							<span class="hidden border border-flag-blue/20 bg-flag-white px-2 py-0.5 text-xs font-semibold uppercase tracking-eyebrow text-flag-blue sm:inline">Admin</span>
						</a>
						<div class="flex flex-col gap-3 sm:flex-row sm:items-center">
							<nav data-testid="admin-nav" aria-label="Admin navigation" class="flex flex-wrap gap-2 text-sm font-medium text-flag-blue">
								<a data-testid="admin-nav-dashboard" aria-current="page" href="/admin" class="inline-flex h-10 items-center justify-center bg-flag-blue px-4 text-white transition hover:bg-ink">Dashboard</a>
								<a data-testid="admin-nav-products" href="/admin/products" class="inline-flex h-10 items-center justify-center border border-flag-blue/20 bg-paper px-4 transition hover:border-flag-red hover:text-flag-red">Products</a>
								<a data-testid="admin-nav-categories" href="/admin/categories" class="inline-flex h-10 items-center justify-center border border-flag-blue/20 bg-paper px-4 transition hover:border-flag-red hover:text-flag-red">Categories</a>
								<a data-testid="admin-nav-orders" href="/admin/orders" class="inline-flex h-10 items-center justify-center border border-flag-blue/20 bg-paper px-4 transition hover:border-flag-red hover:text-flag-red">Orders</a>
							</nav>
							<form method="post" action="/admin/logout" class="flex">
								<input type="hidden" name="csrf_token" value={ vm.CSRFValue }/>
								<button data-testid="admin-logout-button" type="submit" class="inline-flex h-10 items-center justify-center bg-flag-red px-4 text-sm font-bold text-white transition hover:bg-flag-red-deep">Logout</button>
							</form>
						</div>
					</div>
				</header>
				<main id="admin-main" class="mx-auto w-full max-w-7xl px-5 py-10 sm:px-8 lg:py-14">
					<section aria-labelledby="admin-dashboard-title" class="border border-flag-blue bg-flag-blue text-white">
						@adminFlagBand("h-1.5")
						<div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-[1fr_0.9fr] lg:items-center">
							<div>
								<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-white">Back office</p>
								<h1 id="admin-dashboard-title" class="mt-3 font-display text-5xl font-bold leading-none tracking-tight text-white sm:text-6xl">Admin dashboard</h1>
								<p class="mt-5 max-w-3xl text-lg leading-8 text-white/80">A focused workspace for live catalog operations: publish readiness, category coverage, and low-stock variant attention.</p>
							</div>
							<div class="border border-white/25 bg-white/10 p-5">
								<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-white">Operational pulse</p>
								<p class="mt-3 text-base leading-7 text-white/90">Counts refresh from the admin catalog store on each no-store request, so filters and lists stay grounded in the same mutable data.</p>
							</div>
						</div>
					</section>
					<section aria-label="Catalog metrics" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
						<article class="border border-flag-blue/15 bg-paper lg:col-span-2">
							<span aria-hidden="true" class="block h-1.5 bg-flag-red"></span>
							<div class="p-5">
								<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Total products</p>
								<p data-testid="admin-metric-products" class="mt-3 font-display text-4xl font-bold leading-none text-flag-blue">{ strconv.Itoa(vm.TotalProducts) }</p>
								<p class="mt-2 text-sm leading-6 text-muted">All product records, including draft and archived rows.</p>
							</div>
						</article>
						<article class="border border-flag-blue/15 bg-paper p-5">
							<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Active</p>
							<p data-testid="admin-metric-products-active" class="mt-3 font-display text-3xl font-bold leading-none text-flag-blue">{ strconv.Itoa(vm.ActiveProducts) }</p>
						</article>
						<article class="border border-flag-blue/15 bg-paper p-5">
							<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Draft</p>
							<p data-testid="admin-metric-products-draft" class="mt-3 font-display text-3xl font-bold leading-none text-flag-blue">{ strconv.Itoa(vm.DraftProducts) }</p>
						</article>
						<article class="border border-flag-blue/15 bg-paper p-5">
							<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Archived</p>
							<p data-testid="admin-metric-products-archived" class="mt-3 font-display text-3xl font-bold leading-none text-flag-blue">{ strconv.Itoa(vm.ArchivedProducts) }</p>
						</article>
						<article class="border border-flag-blue/15 bg-paper p-5">
							<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Categories</p>
							<p data-testid="admin-metric-categories" class="mt-3 font-display text-3xl font-bold leading-none text-flag-blue">{ strconv.Itoa(vm.Categories) }</p>
						</article>
						<article class="border border-flag-red/25 bg-paper lg:col-span-3">
							<span aria-hidden="true" class="block h-1.5 bg-gold"></span>
							<div class="p-5">
								<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Low-stock active variants</p>
								<p data-testid="admin-metric-low-stock" class="mt-3 font-display text-4xl font-bold leading-none text-flag-blue">{ strconv.Itoa(vm.LowStockVariants) }</p>
								<p class="mt-2 text-sm leading-6 text-muted">Active variant rows at 2 units or fewer, excluding archived products and archived variants.</p>
							</div>
						</article>
						<article class="border border-flag-blue/15 bg-paper lg:col-span-3">
							<span aria-hidden="true" class="block h-1.5 bg-flag-blue"></span>
							<div class="p-5">
								<p class="text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Image upload failures</p>
								<p data-testid="admin-metric-upload-failures" class="mt-3 font-display text-4xl font-bold leading-none text-flag-blue">{ strconv.Itoa(vm.UploadFailures) }</p>
								<p class="mt-2 text-sm leading-6 text-muted">Session-only browser failures from the product image confirmation flow.</p>
							</div>
						</article>
					</section>
					<section aria-label="Admin workspaces" class="mt-8 grid gap-5 md:grid-cols-3">
						<a href="/admin" class="group block border border-flag-red/30 bg-paper transition hover:border-flag-blue hover:shadow-lift">
							<span aria-hidden="true" class="block h-1.5 bg-flag-red"></span>
							<span class="block p-5">
								<span class="block text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Current</span>
								<span class="mt-3 block font-display text-xl font-medium text-flag-blue transition group-hover:text-flag-red">Dashboard</span>
								<span class="mt-3 block text-sm leading-6 text-muted">Start here for the protected admin shell and future operational summaries.</span>
							</span>
						</a>
						<a href="/admin/products" class="group block border border-flag-blue/15 bg-paper transition hover:border-flag-blue hover:shadow-lift">
							<span aria-hidden="true" class="block h-1.5 bg-flag-blue"></span>
							<span class="block p-5">
								<span class="block text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Catalog</span>
								<span class="mt-3 block font-display text-xl font-medium text-flag-blue transition group-hover:text-flag-red">Product workspace</span>
								<span class="mt-3 block text-sm leading-6 text-muted">Placeholder entry point for product management without adding mutation forms yet.</span>
							</span>
						</a>
						<a href="/admin/categories" class="group block border border-flag-blue/15 bg-paper transition hover:border-flag-blue hover:shadow-lift">
							<span aria-hidden="true" class="block h-1.5 bg-gold"></span>
							<span class="block p-5">
								<span class="block text-xs font-semibold uppercase tracking-eyebrow text-flag-red">Aisles</span>
								<span class="mt-3 block font-display text-xl font-medium text-flag-blue transition group-hover:text-flag-red">Category workspace</span>
								<span class="mt-3 block text-sm leading-6 text-muted">Placeholder entry point for category management without implementing CRUD pages.</span>
							</span>
						</a>
					</section>
				</main>
			</div>
			<script>
				(() => {
					const uploadFailures = document.querySelector('[data-testid="admin-metric-upload-failures"]');
					if (!uploadFailures) return;
					uploadFailures.textContent = window.sessionStorage.getItem('adminProductImageUploadFailures') || uploadFailures.textContent;
				})();
			</script>
		</body>
	</html>
}
