package admin

import "strconv"

templ adminHead(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ title }</title>
		<link rel="icon" href="/static/favicon.ico" sizes="any"/>
		<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
		<link rel="apple-touch-icon" href="/static/apple-touch-icon.png" sizes="180x180"/>
		<link rel="manifest" href="/static/site.webmanifest"/>
		<link rel="stylesheet" href="/static/assets/app.css"/>
	</head>
}

templ adminDashboardPage(vm adminDashboardViewModel) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		@adminHead("Admin dashboard | Thailand Gift Shop")
		<body class="min-h-screen bg-[#F8F4EE] text-[#17172A] antialiased">
			<div data-testid="admin-shell" class="min-h-screen">
				<header class="sticky top-0 z-30 border-b border-[#2D2A4A]/10 bg-white/95 shadow-sm backdrop-blur">
					<div aria-hidden="true" class="grid h-1 grid-cols-[1fr_1fr_2fr_1fr_1fr]">
						<span class="bg-[#A51931]"></span>
						<span class="bg-[#F4F5F8]"></span>
						<span class="bg-[#2D2A4A]"></span>
						<span class="bg-[#F4F5F8]"></span>
						<span class="bg-[#A51931]"></span>
					</div>
					<div class="mx-auto flex min-h-16 w-full max-w-7xl flex-col gap-4 px-5 py-4 sm:px-8 md:flex-row md:items-center md:justify-between">
						<a href="/admin" aria-label="Thailand Gift Shop admin dashboard" class="flex min-w-0 items-center gap-3">
							<img class="h-10 w-auto max-w-[52vw] sm:h-12 sm:max-w-[240px]" src="/static/logo.svg" alt="Thailand Gift Shop"/>
							<span class="hidden rounded-full bg-[#2D2A4A]/10 px-3 py-1 text-xs font-black uppercase tracking-wide text-[#2D2A4A] sm:inline">Admin</span>
						</a>
						<div class="flex flex-col gap-3 sm:flex-row sm:items-center">
							<nav data-testid="admin-nav" aria-label="Admin navigation" class="flex flex-wrap gap-2 text-sm font-black text-[#2D2A4A]">
								<a data-testid="admin-nav-dashboard" aria-current="page" href="/admin" class="inline-flex h-10 items-center justify-center rounded-full bg-[#2D2A4A] px-4 text-white shadow-sm transition hover:bg-[#17172A] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#A51931]">Dashboard</a>
								<a data-testid="admin-nav-products" href="/admin/products" class="inline-flex h-10 items-center justify-center rounded-full border border-[#2D2A4A]/15 bg-white px-4 shadow-sm transition hover:border-[#A51931]/30 hover:text-[#A51931] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2D2A4A]">Products</a>
								<a data-testid="admin-nav-categories" href="/admin/categories" class="inline-flex h-10 items-center justify-center rounded-full border border-[#2D2A4A]/15 bg-white px-4 shadow-sm transition hover:border-[#A51931]/30 hover:text-[#A51931] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2D2A4A]">Categories</a>
							</nav>
							<form method="post" action="/admin/logout" class="flex">
								<input type="hidden" name="csrf_token" value={ vm.CSRFValue }/>
								<button data-testid="admin-logout-button" type="submit" class="inline-flex h-10 items-center justify-center rounded-full bg-[#A51931] px-4 text-sm font-black text-white shadow-sm transition hover:bg-[#831426] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2D2A4A]">Logout</button>
							</form>
						</div>
					</div>
				</header>
				<main id="admin-main" class="mx-auto w-full max-w-7xl px-5 py-10 sm:px-8 lg:py-14">
					<section aria-labelledby="admin-dashboard-title" class="overflow-hidden rounded-lg border border-[#2D2A4A]/10 bg-[#2D2A4A] text-white shadow-sm">
						<div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-[1fr_0.9fr] lg:items-center">
							<div>
								<p class="text-sm font-black uppercase tracking-wide text-[#F4F5F8]">Back office</p>
								<h1 id="admin-dashboard-title" class="mt-3 text-5xl font-black leading-none text-white sm:text-6xl">Admin dashboard</h1>
								<p class="mt-5 max-w-3xl text-lg leading-8 text-white/80">A focused workspace for live catalog operations: publish readiness, category coverage, and low-stock variant attention.</p>
							</div>
							<div class="rounded-lg border border-white/25 bg-white/10 p-5 shadow-sm backdrop-blur">
							<p class="text-sm font-black uppercase tracking-wide text-[#F4F5F8]">Operational pulse</p>
							<p class="mt-3 text-base leading-7 text-white/90">Counts refresh from the admin catalog store on each no-store request, so filters and lists stay grounded in the same mutable data.</p>
						</div>
					</div>
				</section>
				<section aria-label="Catalog metrics" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
					<article class="overflow-hidden rounded-lg border border-[#2D2A4A]/15 bg-white shadow-sm lg:col-span-2">
						<span aria-hidden="true" class="block h-1.5 bg-[#A51931]"></span>
						<div class="p-5">
							<p class="text-xs font-black uppercase tracking-wide text-[#A51931]">Total products</p>
							<p data-testid="admin-metric-products" class="mt-3 text-4xl font-black leading-none text-[#2D2A4A]">{ strconv.Itoa(vm.TotalProducts) }</p>
							<p class="mt-2 text-sm font-bold text-[#4C4A62]">All product records, including draft and archived rows.</p>
						</div>
					</article>
					<article class="rounded-lg border border-[#2D2A4A]/15 bg-white p-5 shadow-sm">
						<p class="text-xs font-black uppercase tracking-wide text-[#A51931]">Active</p>
						<p data-testid="admin-metric-products-active" class="mt-3 text-3xl font-black leading-none text-[#2D2A4A]">{ strconv.Itoa(vm.ActiveProducts) }</p>
					</article>
					<article class="rounded-lg border border-[#2D2A4A]/15 bg-white p-5 shadow-sm">
						<p class="text-xs font-black uppercase tracking-wide text-[#A51931]">Draft</p>
						<p data-testid="admin-metric-products-draft" class="mt-3 text-3xl font-black leading-none text-[#2D2A4A]">{ strconv.Itoa(vm.DraftProducts) }</p>
					</article>
					<article class="rounded-lg border border-[#2D2A4A]/15 bg-white p-5 shadow-sm">
						<p class="text-xs font-black uppercase tracking-wide text-[#A51931]">Archived</p>
						<p data-testid="admin-metric-products-archived" class="mt-3 text-3xl font-black leading-none text-[#2D2A4A]">{ strconv.Itoa(vm.ArchivedProducts) }</p>
					</article>
					<article class="rounded-lg border border-[#2D2A4A]/15 bg-white p-5 shadow-sm">
						<p class="text-xs font-black uppercase tracking-wide text-[#A51931]">Categories</p>
						<p data-testid="admin-metric-categories" class="mt-3 text-3xl font-black leading-none text-[#2D2A4A]">{ strconv.Itoa(vm.Categories) }</p>
					</article>
					<article class="overflow-hidden rounded-lg border border-[#A51931]/25 bg-white shadow-sm lg:col-span-3">
						<span aria-hidden="true" class="block h-1.5 bg-[#D8AE5E]"></span>
						<div class="p-5">
							<p class="text-xs font-black uppercase tracking-wide text-[#A51931]">Low-stock active variants</p>
							<p data-testid="admin-metric-low-stock" class="mt-3 text-4xl font-black leading-none text-[#2D2A4A]">{ strconv.Itoa(vm.LowStockVariants) }</p>
							<p class="mt-2 text-sm font-bold text-[#4C4A62]">Active variant rows at 2 units or fewer, excluding archived products and archived variants.</p>
						</div>
					</article>
					<article class="overflow-hidden rounded-lg border border-[#2D2A4A]/15 bg-white shadow-sm lg:col-span-3">
						<span aria-hidden="true" class="block h-1.5 bg-[#2D2A4A]"></span>
						<div class="p-5">
							<p class="text-xs font-black uppercase tracking-wide text-[#A51931]">Image upload failures</p>
							<p data-testid="admin-metric-upload-failures" class="mt-3 text-4xl font-black leading-none text-[#2D2A4A]">{ strconv.Itoa(vm.UploadFailures) }</p>
							<p class="mt-2 text-sm font-bold text-[#4C4A62]">Session-only browser failures from the product image confirmation flow.</p>
						</div>
					</article>
				</section>
				<section aria-label="Admin workspaces" class="mt-8 grid gap-5 md:grid-cols-3">
						<a href="/admin" class="group block overflow-hidden rounded-lg border border-[#A51931]/30 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
							<span aria-hidden="true" class="block h-1.5 bg-[#A51931]"></span>
							<span class="block p-5">
								<span class="block text-sm font-black uppercase tracking-wide text-[#A51931]">Current</span>
								<span class="mt-3 block text-xl font-black text-[#2D2A4A] transition group-hover:text-[#831426]">Dashboard</span>
								<span class="mt-3 block text-sm leading-6 text-[#4C4A62]">Start here for the protected admin shell and future operational summaries.</span>
							</span>
						</a>
						<a href="/admin/products" class="group block overflow-hidden rounded-lg border border-[#2D2A4A]/15 bg-white shadow-sm transition hover:-translate-y-1 hover:border-[#A51931]/30 hover:shadow-lg">
							<span aria-hidden="true" class="block h-1.5 bg-[#2D2A4A]"></span>
							<span class="block p-5">
								<span class="block text-sm font-black uppercase tracking-wide text-[#A51931]">Catalog</span>
								<span class="mt-3 block text-xl font-black text-[#2D2A4A] transition group-hover:text-[#831426]">Product workspace</span>
								<span class="mt-3 block text-sm leading-6 text-[#4C4A62]">Placeholder entry point for product management without adding mutation forms yet.</span>
							</span>
						</a>
						<a href="/admin/categories" class="group block overflow-hidden rounded-lg border border-[#2D2A4A]/15 bg-white shadow-sm transition hover:-translate-y-1 hover:border-[#A51931]/30 hover:shadow-lg">
							<span aria-hidden="true" class="block h-1.5 bg-[#D8AE5E]"></span>
							<span class="block p-5">
								<span class="block text-sm font-black uppercase tracking-wide text-[#A51931]">Aisles</span>
								<span class="mt-3 block text-xl font-black text-[#2D2A4A] transition group-hover:text-[#831426]">Category workspace</span>
								<span class="mt-3 block text-sm leading-6 text-[#4C4A62]">Placeholder entry point for category management without implementing CRUD pages.</span>
							</span>
						</a>
					</section>
				</main>
			</div>
			<script>
				(() => {
					const uploadFailures = document.querySelector('[data-testid="admin-metric-upload-failures"]');
					if (!uploadFailures) return;
					uploadFailures.textContent = window.sessionStorage.getItem('adminProductImageUploadFailures') || uploadFailures.textContent;
				})();
			</script>
		</body>
	</html>
}
